{
  "name": "lex.atproto.blue",
  "short_name": "lex",
  "description": "Third-party AT Protocol lexicons, packaged for the atproto Python SDK.",
  "start_url": "./",
  "display": "browser",
  "background_color": "#F5F8FC",
  "theme_color": "#0B6BDB",
