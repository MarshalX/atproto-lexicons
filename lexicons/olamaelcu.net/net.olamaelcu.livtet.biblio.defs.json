{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "bookFormat": {
      "description": "Normalized physical or digital format of an edition.",
      "knownValues": [
        "hardcover",
        "paperback",
        "mass_market_paperback",
        "ebook",
        "audiobook",
        "board_book",
        "spiral_bound"
      ],
      "type": "string"
    },
    "bookShelfMetadata": {
      "properties": {
        "emoji": {
          "description": "Emoji representing this book on the shelf.",
          "maxGraphemes": 8,
          "type": "string"
        },
        "finishedAt": {
          "description": "When the reader finished the book, when known.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "notes": {
          "description": "Personal notes about this book on the shelf.",
          "maxGraphemes": 8192,
          "type": "string"
        },
        "position": {
          "description": "Position of the book within the shelf (1-indexed).",
          "minimum": 1,
          "type": "integer"
        },
        "startedAt": {
          "description": "When the reader started the book, when known.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "status": {
          "description": "Reading status for this book.",
          "ref": "net.olamaelcu.livtet.biblio.defs#readingStatus",
          "type": "ref"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "bookShelfView": {
      "properties": {
        "book": {
          "description": "The book on the shelf.",
          "ref": "net.olamaelcu.livtet.biblio.defs#bookView",
          "type": "ref"
        },
        "createdAt": {
          "description": "Timestamp when the record was originally created.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "did": {
          "description": "DID of the account that shelved the book.",
          "format": "did",
          "type": "string"
        },
        "metadata": {
          "description": "Shelf-specific metadata for this book.",
          "ref": "net.olamaelcu.livtet.biblio.defs#bookShelfMetadata",
          "type": "ref"
        },
        "shelf": {
          "description": "The shelf the book is on.",
          "ref": "net.olamaelcu.livtet.biblio.defs#shelfView",
          "type": "ref"
        },
        "updatedAt": {
          "description": "Timestamp of the last update to the record.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "uri": {
          "description": "AT-URI of the bookShelf record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "shelf",
        "book",
        "metadata",
        "did"
      ],
      "type": "object"
    },
    "bookView": {
      "description": "A catalog book: the edition AT-URI plus its current edition view.",
      "properties": {
        "edition": {
          "description": "The edition metadata for this book.",
          "ref": "community.lexicon.media.book.defs#editionView",
          "type": "ref"
        },
        "uri": {
          "description": "AT-URI of the catalog edition record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "edition"
      ],
      "type": "object"
    },
    "bskyEngagement": {
      "description": "Public Bluesky engagement counts for an at-uri subject.",
      "properties": {
        "likeCount": {
          "description": "Number of like records referencing the subject.",
          "minimum": 0,
          "type": "integer"
        },
        "quoteCount": {
          "description": "Number of post records embedding the subject as a quoted record.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "likeCount",
        "quoteCount"
      ],
      "type": "object"
    },
    "contributorClaimView": {
      "description": "One reader's contributor claim and where it stands.",
      "properties": {
        "contributor": {
          "format": "at-uri",
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "decidedAt": {
          "format": "datetime",
          "type": "string"
        },
        "message": {
          "maxGraphemes": 512,
          "type": "string"
        },
        "state": {
          "knownValues": [
            "pending",
            "approved",
            "rejected",
            "revoked"
          ],
          "type": "string"
        },
        "uri": {
          "description": "AT-URI of the claim record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "contributor",
        "state",
        "createdAt"
      ],
      "type": "object"
    },
    "contributorIdentity": {
      "description": "One verified account for a contributor, as published by net.olamaelcu.livtet.biblio.knownContributor.",
      "properties": {
        "contributor": {
          "description": "The contributor record the account is.",
          "format": "at-uri",
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "did": {
          "description": "The verified account.",
          "format": "did",
          "type": "string"
        },
        "uri": {
          "description": "AT-URI of the knownContributor record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "did",
        "contributor",
        "createdAt"
      ],
      "type": "object"
    },
    "contributorView": {
      "description": "A contributor record with the address it is published at.",
      "properties": {
        "born": {
          "description": "Birth date, exactly YYYY-MM-DD.",
          "type": "string"
        },
        "cid": {
          "description": "CID of the last published version of the record, when the catalog has published it. Omitted from list responses.",
          "format": "cid",
          "type": "string"
        },
        "createdAt": {
          "description": "When the contributor record was created.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "description": {
          "description": "Biography or description of the contributor.",
          "type": "string"
        },
        "died": {
          "description": "Death date, exactly YYYY-MM-DD.",
          "type": "string"
        },
        "displayName": {
          "description": "The contributor's display name.",
          "type": "string"
        },
        "identifiers": {
          "description": "Identifiers denoting the contributor.",
          "items": {
            "ref": "community.lexicon.media.book.defs#identifier",
            "type": "ref"
          },
          "type": "array"
        },
        "image": {
          "accept": [
            "image/*"
          ],
          "description": "Portrait image blob, when the publishing repository owns the bytes.",
          "type": "blob"
        },
        "imageUrl": {
          "description": "Portrait image URL, when the record carries one.",
          "format": "uri",
          "type": "string"
        },
        "nameInverted": {
          "description": "Name in filing or sorting order, when known.",
          "type": "string"
        },
        "uri": {
          "description": "AT-URI of the contributor record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "displayName",
        "createdAt"
      ],
      "type": "object"
    },
    "formatView": {
      "properties": {
        "description": {
          "description": "Human-readable description of the format.",
          "maxGraphemes": 128,
          "type": "string"
        },
        "emoji": {
          "description": "Emoji representing the format.",
          "maxGraphemes": 8,
          "type": "string"
        },
        "format": {
          "description": "The normalized format value.",
          "ref": "net.olamaelcu.livtet.biblio.defs#bookFormat",
          "type": "ref"
        },
        "iconImageUrl": {
          "description": "Small image URL for the format.",
          "format": "uri",
          "type": "string"
        },
        "unit": {
          "description": "The unit a progress value for a book in this format is measured in.",
          "ref": "net.olamaelcu.livtet.biblio.defs#progressUnit",
          "type": "ref"
        },
        "uri": {
          "description": "AT-URI of the format record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "format",
        "uri",
        "description",
        "emoji",
        "unit"
      ],
      "type": "object"
    },
    "genreView": {
      "properties": {
        "bsky": {
          "description": "Public Bluesky engagement for this genre, when non-zero.",
          "ref": "net.olamaelcu.livtet.biblio.defs#bskyEngagement",
          "type": "ref"
        },
        "description": {
          "description": "What this genre covers.",
          "maxGraphemes": 512,
          "type": "string"
        },
        "emoji": {
          "description": "Emoji representing the genre.",
          "maxGraphemes": 8,
          "type": "string"
        },
        "iconImageUrl": {
          "description": "Small icon image URL for the genre.",
          "format": "uri",
          "type": "string"
        },
        "identifiers": {
          "description": "External identifiers for the genre.",
          "items": {
            "ref": "net.olamaelcu.livtet.biblio.defs#identifier",
            "type": "ref"
          },
          "type": "array"
        },
        "name": {
          "description": "Display name of the genre.",
          "maxGraphemes": 64,
          "type": "string"
        },
        "parent": {
          "description": "AT-URI of the parent genre, if any.",
          "format": "at-uri",
          "type": "string"
        },
        "uri": {
          "description": "AT-URI of the genre record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "name",
        "description",
        "emoji"
      ],
      "type": "object"
    },
    "giveawayView": {
      "description": "One author giveaway, as the activity index holds it. `entries` is the number of entry records pointing at this giveaway; `draw` appears once the author has concluded it.",
      "properties": {
        "author": {
          "description": "The repo the giveaway record lives in: the verified author's account.",
          "format": "did",
          "type": "string"
        },
        "cid": {
          "format": "cid",
          "type": "string"
        },
        "closesAt": {
          "format": "datetime",
          "type": "string"
        },
        "closingNote": {
          "maxGraphemes": 500,
          "type": "string"
        },
        "countries": {
          "description": "ISO-3166 alpha-2 codes, or the single value `*` for worldwide.",
          "items": {
            "maxLength": 2,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "coverUrl": {
          "format": "uri",
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "draw": {
          "description": "The stored draw, present once the giveaway has been concluded.",
          "properties": {
            "drawnAt": {
              "format": "datetime",
              "type": "string"
            },
            "seed": {
              "type": "string"
            },
            "winners": {
              "items": {
                "format": "did",
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "drawnAt",
            "seed",
            "winners"
          ],
          "type": "object"
        },
        "edition": {
          "format": "at-uri",
          "type": "string"
        },
        "entries": {
          "minimum": 0,
          "type": "integer"
        },
        "opensAt": {
          "format": "datetime",
          "type": "string"
        },
        "prizeQuantity": {
          "minimum": 1,
          "type": "integer"
        },
        "prizeType": {
          "knownValues": [
            "print",
            "digital",
            "audio"
          ],
          "type": "string"
        },
        "rulesText": {
          "maxGraphemes": 4000,
          "type": "string"
        },
        "title": {
          "maxGraphemes": 200,
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "cid",
        "author",
        "edition",
        "title",
        "prizeType",
        "prizeQuantity",
        "countries",
        "rulesText",
        "opensAt",
        "closesAt",
        "createdAt",
        "entries"
      ],
      "type": "object"
    },
    "identifier": {
      "description": "An external identifier for a record, such as an ISBN or Open Library key.",
      "properties": {
        "resource": {
          "description": "The identifier value issued by the external source.",
          "maxGraphemes": 128,
          "type": "string"
        },
        "url": {
          "description": "URL where the identifier can be resolved.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "resource",
        "url"
      ],
      "type": "object"
    },
    "progressUnit": {
      "description": "The unit a progress value is measured in.",
      "knownValues": [
        "other",
        "pages",
        "seconds",
        "percent"
      ],
      "type": "string"
    },
    "publisherView": {
      "description": "A publisher record with the address it is published at.",
      "properties": {
        "cid": {
          "description": "CID of the last published version of the record, when the catalog has published it. Omitted from list responses.",
          "format": "cid",
          "type": "string"
        },
        "createdAt": {
          "description": "When the publisher record was created.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "description": {
          "description": "Description of the publisher.",
          "type": "string"
        },
        "ended": {
          "description": "Date the publisher ceased operating, exactly YYYY-MM-DD.",
          "type": "string"
        },
        "identifiers": {
          "description": "Identifiers denoting the publisher.",
          "items": {
            "ref": "community.lexicon.media.book.defs#identifier",
            "type": "ref"
          },
          "type": "array"
        },
        "image": {
          "accept": [
            "image/*"
          ],
          "description": "Logo or image blob, when the publishing repository owns the bytes.",
          "type": "blob"
        },
        "imageUrl": {
          "description": "Logo or image URL, when the record carries one.",
          "format": "uri",
          "type": "string"
        },
        "name": {
          "description": "Publisher name.",
          "type": "string"
        },
        "started": {
          "description": "Date the publisher began operating, exactly YYYY-MM-DD.",
          "type": "string"
        },
        "uri": {
          "description": "AT-URI of the publisher record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "name",
        "createdAt"
      ],
      "type": "object"
    },
    "reactionView": {
      "description": "An emoji reaction with its author.",
      "properties": {
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "did": {
          "description": "DID of the reacting account.",
          "format": "did",
          "type": "string"
        },
        "emoji": {
          "description": "The emoji, carrying whatever skin-tone modifier the reactor's profile applied. One grapheme, so a toned emoji is still one character.",
          "maxGraphemes": 1,
          "type": "string"
        },
        "uri": {
          "description": "AT-URI of the reaction record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "did",
        "emoji",
        "createdAt"
      ],
      "type": "object"
    },
    "readingStatus": {
      "description": "Reading status for a book.",
      "knownValues": [
        "reading",
        "to-read",
        "dnf",
        "read"
      ],
      "type": "string"
    },
    "reviewReplyView": {
      "description": "One reply in a review's conversation, with its own reactions.",
      "properties": {
        "did": {
          "format": "did",
          "type": "string"
        },
        "reactions": {
          "description": "Every reaction record naming this reply, so a bar needs no second call. Empty when the page carries more than 20 replies.",
          "items": {
            "ref": "net.olamaelcu.livtet.biblio.defs#reactionView",
            "type": "ref"
          },
          "type": "array"
        },
        "record": {
          "ref": "net.olamaelcu.livtet.biblio.reviewReply#main",
          "type": "ref"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "did",
        "record",
        "reactions"
      ],
      "type": "object"
    },
    "reviewView": {
      "description": "A review record with its author.",
      "properties": {
        "did": {
          "description": "DID of the review author.",
          "format": "did",
          "type": "string"
        },
        "record": {
          "description": "The review record value.",
          "ref": "community.lexicon.media.book.review#main",
          "type": "ref"
        },
        "uri": {
          "description": "AT-URI of the review record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "did",
        "record"
      ],
      "type": "object"
    },
    "shelfItemMetadata": {
      "description": "Optional ordering and presentation metadata for a book's place on a shelf.",
      "properties": {
        "emoji": {
          "description": "Emoji representing this book on the shelf.",
          "maxGraphemes": 8,
          "type": "string"
        },
        "notes": {
          "description": "Personal notes about this book on the shelf.",
          "maxGraphemes": 8192,
          "type": "string"
        },
        "position": {
          "description": "Position of the book within the shelf (1-indexed).",
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "shelfItemView": {
      "description": "A book placed on a shelf, hydrated with the shelf and book views.",
      "properties": {
        "book": {
          "description": "The book on the shelf.",
          "ref": "net.olamaelcu.livtet.biblio.defs#bookView",
          "type": "ref"
        },
        "createdAt": {
          "description": "Timestamp when the record was originally created.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "did": {
          "description": "DID of the account that owns the shelf.",
          "format": "did",
          "type": "string"
        },
        "metadata": {
          "description": "Position, notes and emoji for this book's place on the shelf.",
          "ref": "net.olamaelcu.livtet.biblio.defs#shelfItemMetadata",
          "type": "ref"
        },
        "shelf": {
          "description": "The shelf the book is on.",
          "ref": "net.olamaelcu.livtet.biblio.defs#shelfView",
          "type": "ref"
        },
        "updatedAt": {
          "description": "Timestamp of the last update to the record.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "uri": {
          "description": "AT-URI of the shelfItem record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "shelf",
        "book",
        "metadata",
        "did"
      ],
      "type": "object"
    },
    "shelfView": {
      "properties": {
        "bsky": {
          "description": "Public Bluesky engagement for this shelf, when non-zero.",
          "ref": "net.olamaelcu.livtet.biblio.defs#bskyEngagement",
          "type": "ref"
        },
        "createdAt": {
          "description": "Timestamp when the record was originally created.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "description": {
          "description": "Description of the shelf.",
          "maxGraphemes": 8192,
          "type": "string"
        },
        "name": {
          "description": "Display name of the shelf.",
          "maxGraphemes": 128,
          "type": "string"
        },
        "updatedAt": {
          "description": "Timestamp of the last update to the record.",
          "ref": "net.olamaelcu.livtet.biblio.defs#timestamp",
          "type": "ref"
        },
        "uri": {
          "description": "AT-URI of the shelf record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "name"
      ],
      "type": "object"
    },
    "shelfWithBooksView": {
      "properties": {
        "books": {
          "description": "Books on the shelf — status rows and membership edges — lowest `metadata.position` first, then record URI.",
          "items": {
            "refs": [
              "net.olamaelcu.livtet.biblio.defs#bookShelfView",
              "net.olamaelcu.livtet.biblio.defs#shelfItemView"
            ],
            "type": "union"
          },
          "type": "array"
        },
        "shelf": {
          "description": "The shelf.",
          "ref": "net.olamaelcu.livtet.biblio.defs#shelfView",
          "type": "ref"
        }
      },
      "required": [
        "shelf",
        "books"
      ],
      "type": "object"
    },
    "timestamp": {
      "description": "An ISO-8601 datetime (RFC 3339).",
      "format": "datetime",
      "type": "string"
    }
  },
  "id": "net.olamaelcu.livtet.biblio.defs",
  "lexicon": 1
}
