{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "errors": [
        {
          "description": "No book record exists at the given AT-URI.",
          "name": "NotFound"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "bookShelves": {
              "items": {
                "refs": [
                  "net.olamaelcu.livtet.biblio.defs#bookShelfView",
                  "net.olamaelcu.livtet.biblio.defs#shelfItemView"
                ],
                "type": "union"
              },
              "type": "array"
            },
            "cursor": {
              "type": "string"
            }
          },
          "required": [
            "bookShelves"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "book": {
            "description": "AT-URI of the book to find on shelves.",
            "format": "at-uri",
            "type": "string"
          },
          "cursor": {
            "description": "Opaque pagination cursor.",
            "type": "string"
          },
          "did": {
            "description": "DID of the account whose shelves to search.",
            "format": "did",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "description": "Maximum number of shelf entries to return.",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "book",
          "did"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "description": "List the shelves a given book is on, as bookStatus rows and shelfItem memberships.",
  "id": "net.olamaelcu.livtet.biblio.getShelvingOfBook",
  "lexicon": 1
}
