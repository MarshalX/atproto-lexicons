{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "One list member's role, written in the list owner's repo inside the list space. The record key is the subject's DID, so a member holds at most one role. `Owner` is never a value here — the list's authority is the owner.",
      "key": "any",
      "record": {
        "properties": {
          "role": {
            "maxLength": 64,
            "type": "string"
          },
          "subject": {
            "format": "did",
            "type": "string"
          },
          "updatedAt": {
            "format": "datetime",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "role",
          "updatedAt"
        ],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "net.olamaelcu.livtet.biblio.readingList.roleAssignment",
  "lexicon": 1
}
