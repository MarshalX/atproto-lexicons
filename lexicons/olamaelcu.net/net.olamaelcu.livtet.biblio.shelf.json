{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "One shelf in a reader's own repo: a built-in reading status (`reading`, `read`, `to-read`, `dnf`, filed under that status as its key) or a shelf the reader named. A `bookStatus` or `shelfItem` record points at the shelf it belongs to.",
      "key": "any",
      "record": {
        "properties": {
          "createdAt": {
            "format": "datetime",
            "type": "string"
          },
          "description": {
            "maxGraphemes": 2000,
            "type": "string"
          },
          "name": {
            "description": "The shelf's own name, as the profile shows it.",
            "maxGraphemes": 120,
            "type": "string"
          },
          "updatedAt": {
            "format": "datetime",
            "type": "string"
          }
        },
        "required": [
          "name",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "net.olamaelcu.livtet.biblio.shelf",
  "lexicon": 1
}
