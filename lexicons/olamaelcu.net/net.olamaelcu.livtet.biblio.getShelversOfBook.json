{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "bookUri": {
              "description": "The book the DIDs shelved, echoed from the request.",
              "format": "at-uri",
              "type": "string"
            },
            "cursor": {
              "description": "Opaque pagination cursor; absent when no further DIDs are known.",
              "type": "string"
            },
            "dids": {
              "description": "Distinct DIDs in `min(uri)` order. Every uri starts with `at://<did>/…`, so this is lexicographic DID order — which is what makes the keyset cursor strict.",
              "items": {
                "format": "did",
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "bookUri",
            "dids"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "bookUri": {
            "description": "AT-URI of the catalog book whose shelvers to list.",
            "format": "at-uri",
            "type": "string"
          },
          "cursor": {
            "description": "Opaque pagination cursor.",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "description": "Maximum number of distinct DIDs to return.",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "bookUri"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "description": "List the DIDs that put a given book on one of their shelves.",
  "id": "net.olamaelcu.livtet.biblio.getShelversOfBook",
  "lexicon": 1
}
