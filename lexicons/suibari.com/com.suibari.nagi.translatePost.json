{
  "id": "com.suibari.nagi.translatePost",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "required": [
            "uri",
            "targetLang"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "targetLang": {
              "type": "string",
              "format": "language"
            }
          }
        },
        "encoding": "application/json"
      },
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "cached": {
              "type": "boolean"
            }
          }
        },
        "encoding": "application/json"
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
