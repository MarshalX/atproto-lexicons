{
  "id": "com.suibari.nagi.news",
  "defs": {
    "main": {
      "key": "any",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "articleId",
          "url",
          "titleJa",
          "langs",
          "createdAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "langs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "language"
            },
            "maxLength": 3
          },
          "titleJa": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300
          },
          "articleId": {
            "type": "string",
            "maxLength": 512
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "sourceName": {
            "type": "string",
            "maxLength": 2000,
            "maxGraphemes": 200
          },
          "publishedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
