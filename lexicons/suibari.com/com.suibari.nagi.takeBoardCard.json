{
  "id": "com.suibari.nagi.takeBoardCard",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "required": [
            "card",
            "price"
          ],
          "properties": {
            "card": {
              "type": "unknown",
              "description": "{ volume, id }"
            },
            "price": {
              "type": "integer",
              "minimum": 1,
              "description": "画面に出ていた額。これより高くなっていたら out_of_stock（AAR がボードから消えて botたんの額になった）。"
            }
          }
        },
        "encoding": "application/json"
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "already_owned"
        },
        {
          "name": "out_of_stock"
        },
        {
          "name": "insufficient_zenny"
        }
      ],
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "card",
            "paid",
            "balance"
          ],
          "properties": {
            "card": {
              "type": "unknown",
              "description": "受け取ったカードの CardView。receivedFrom が付く。コメントは非同期生成。"
            },
            "paid": {
              "type": "integer"
            },
            "balance": {
              "type": "integer"
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "おすそわけボードから、まだ持っていないカードを1枚、Ƶ を払って受け取る。早い者勝ち。AAR はボードに無ければ botたんの分を受け取る。提供者は枚数で重み付けしたランダムで選ばれ、カードに「〜からもらった」が付く。要認証。"
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
