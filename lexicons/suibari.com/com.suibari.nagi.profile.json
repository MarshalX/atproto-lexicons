{
  "id": "com.suibari.nagi.profile",
  "defs": {
    "main": {
      "key": "literal:self",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "displayName",
          "createdAt"
        ],
        "properties": {
          "avatar": {
            "type": "blob",
            "accept": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "maxSize": 1000000
          },
          "website": {
            "type": "string",
            "maxLength": 2048
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "description": {
            "type": "string",
            "maxLength": 2560,
            "maxGraphemes": 256
          },
          "displayName": {
            "type": "string",
            "maxLength": 640,
            "maxGraphemes": 64
          }
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
