{
  "id": "com.suibari.nagi.donateCards",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "card": {
              "type": "unknown",
              "description": "mode=single のとき必須。{ volume, id }。"
            },
            "mode": {
              "type": "string",
              "knownValues": [
                "all",
                "single"
              ]
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "description": "mode=single の枚数。省略時は1。置ける枚数を超えたらエラー。"
            }
          }
        },
        "encoding": "application/json"
      },
      "errors": [
        {
          "name": "AuthRequired"
        },
        {
          "name": "not_donatable"
        }
      ],
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "donated",
            "earned",
            "balance"
          ],
          "properties": {
            "earned": {
              "type": "integer"
            },
            "balance": {
              "type": "integer"
            },
            "donated": {
              "type": "array",
              "items": {
                "type": "unknown"
              },
              "description": "置いたカードごとの { volume, id, rarity, quantity, zenny }。図鑑順。演出の並びに使う。"
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "カードをおすそわけボードに置き、Ƶ を受け取る。手元に3枚を残し、ゼンカツでお休み中の在庫には手を付けない。mode=all は置けるぶんをすべて置く。置いたカードは取り下げられない。要認証。"
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
