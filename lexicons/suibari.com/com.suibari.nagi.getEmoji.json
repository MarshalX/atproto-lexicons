{
  "id": "com.suibari.nagi.getEmoji",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "emoji"
          ],
          "properties": {
            "emoji": {
              "type": "unknown"
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "uri"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri"
          }
        }
      },
      "description": "Resolve a blue.moji.collection.item by AT-URI, indexing it on demand when it is not yet known."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
