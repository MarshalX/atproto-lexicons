{
  "id": "me.jgs.pix.pixels",
  "defs": {
    "main": {
      "key": "any",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "graph",
          "year",
          "entries"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "maximum": 9999,
            "minimum": 1
          },
          "graph": {
            "type": "string",
            "format": "tid",
            "description": "Graph ID; the record key of a me.jgs.pix.graph record in the same repo."
          },
          "entries": {
            "type": "array",
            "items": {
              "ref": "#entry",
              "type": "ref"
            },
            "maxLength": 366
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      },
      "description": "One year of pixels for a graph. The record key is '<graphId>:<yyyy>'."
    },
    "entry": {
      "type": "object",
      "required": [
        "date",
        "quantity"
      ],
      "properties": {
        "date": {
          "type": "string",
          "maxLength": 8,
          "minLength": 8,
          "description": "yyyyMMdd"
        },
        "quantity": {
          "type": "string",
          "maxLength": 32,
          "description": "Decimal number as a string; Lexicon has no float type."
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
