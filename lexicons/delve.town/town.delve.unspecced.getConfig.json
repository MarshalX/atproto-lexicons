{
  "id": "town.delve.unspecced.getConfig",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [],
          "properties": {
            "liveNow": {
              "type": "array",
              "items": {
                "ref": "#liveNowConfig",
                "type": "ref"
              }
            },
            "checkEmailConfirmed": {
              "type": "boolean"
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "Get miscellaneous runtime configuration."
    },
    "liveNowConfig": {
      "type": "object",
      "required": [
        "did",
        "domains"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
