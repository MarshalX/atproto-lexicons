{
  "id": "town.delve.authCreatePosts",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Create posts",
      "detail": "Can not update or delete posts.",
      "title:lang": {},
      "detail:lang": {},
      "permissions": [
        {
          "lxm": [
            "town.delve.video.uploadVideo",
            "town.delve.video.getJobStatus",
            "town.delve.video.getUploadLimits",
            "town.delve.video.startUpload",
            "town.delve.video.uploadPart",
            "town.delve.video.finishUpload",
            "town.delve.video.abortUpload",
            "town.delve.video.getUploadStatus"
          ],
          "type": "permission",
          "resource": "rpc",
          "inheritAud": true
        },
        {
          "type": "permission",
          "action": [
            "create"
          ],
          "resource": "repo",
          "collection": [
            "town.delve.feed.post",
            "town.delve.feed.postgate",
            "town.delve.feed.threadgate"
          ]
        }
      ]
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
