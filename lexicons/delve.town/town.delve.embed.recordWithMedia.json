{
  "id": "town.delve.embed.recordWithMedia",
  "defs": {
    "main": {
      "type": "object",
      "required": [
        "record",
        "media"
      ],
      "properties": {
        "media": {
          "refs": [
            "town.delve.embed.images",
            "town.delve.embed.video",
            "town.delve.embed.gallery",
            "town.delve.embed.external"
          ],
          "type": "union"
        },
        "record": {
          "ref": "town.delve.embed.record",
          "type": "ref"
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "record",
        "media"
      ],
      "properties": {
        "media": {
          "refs": [
            "town.delve.embed.images#view",
            "town.delve.embed.video#view",
            "town.delve.embed.gallery#view",
            "town.delve.embed.external#view"
          ],
          "type": "union"
        },
        "record": {
          "ref": "town.delve.embed.record#view",
          "type": "ref"
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "description": "A representation of a record embedded in a Bluesky record (eg, a post), alongside other compatible embeds. For example, a quote post and image, or a quote post and external URL card."
}
