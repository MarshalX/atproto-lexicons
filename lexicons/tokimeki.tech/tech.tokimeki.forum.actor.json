{
  "id": "tech.tokimeki.forum.actor",
  "defs": {
    "main": {
      "key": "literal:self",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "displayName",
          "createdAt"
        ],
        "properties": {
          "avatar": {
            "type": "blob",
            "accept": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ],
            "maxSize": 1000000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "description": {
            "type": "string",
            "maxLength": 2560,
            "maxGraphemes": 256
          },
          "displayName": {
            "type": "string",
            "maxLength": 640,
            "maxGraphemes": 64
          }
        }
      },
      "description": "A user's display profile for tokimeki-space. A regular (non-space) record in the user's own repo, rkey self. Readable by anyone."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
