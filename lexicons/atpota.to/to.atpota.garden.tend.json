{
  "id": "to.atpota.garden.tend",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "action",
          "createdAt"
        ],
        "properties": {
          "action": {
            "type": "string",
            "knownValues": [
              "water",
              "sun",
              "talk"
            ]
          },
          "subject": {
            "ref": "com.atproto.repo.strongRef",
            "type": "ref",
            "description": "The flower (a to.atpota.garden.sprout record)."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "description": "Tending a flower in the flower patch on atpota.to, your own or a neighbour's. Tending while a flower grows makes a better bloom."
}
