{
  "id": "to.atpota.poe.memory",
  "defs": {
    "main": {
      "key": "any",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "notes",
          "updatedAt"
        ],
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "ref": "#note",
              "type": "ref"
            }
          },
          "subject": {
            "type": "string",
            "format": "did",
            "description": "Who the notes are about; always the record key."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "When any note last changed."
          }
        }
      }
    },
    "note": {
      "type": "object",
      "required": [
        "text",
        "createdAt"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 3000,
          "maxGraphemes": 300
        },
        "createdAt": {
          "type": "string",
          "format": "datetime",
          "description": "When Poe saved the note. For notes saved before 2026-10-21, when the stored version holding it arrived."
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "description": "Poe's notes about one person, published in Poe's own repo so anyone, that person included, can read what Poe remembers. One record per person, keyed by their DID, rewritten whenever Poe saves or removes a note, and deleted when they ask to be forgotten."
}
