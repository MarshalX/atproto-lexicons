{
  "id": "app.zeens.notification.updateSeen",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "seenAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "recipient",
          "seenAt"
        ],
        "properties": {
          "seenAt": {
            "type": "string",
            "format": "datetime"
          },
          "recipient": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "description": "Update the recipient's notification seenAt cursor. Everything older than this timestamp is considered read. Modelled as a query because our AppView has no user OAuth session and the write is internal bookkeeping (not a PDS record)."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
