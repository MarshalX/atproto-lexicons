{
  "id": "app.zeens.getFollowingFeed",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "description": "DID of the user whose following feed to retrieve."
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor."
          }
        }
      },
      "description": "Get photos from accounts the requesting user follows. Replaces the fan-out getAuthorFeed pattern.",
      "target_collection": "app.zeens.postMeta"
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
