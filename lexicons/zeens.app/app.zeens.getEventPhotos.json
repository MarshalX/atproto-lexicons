{
  "id": "app.zeens.getEventPhotos",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "event"
        ],
        "properties": {
          "event": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the parent app.zeens.event record."
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          },
          "cursor": {
            "type": "string"
          },
          "viewer": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "description": "List photos tagged to an event via app.zeens.eventPhoto, newest-first by addedAt. Each item is hydrated with the underlying post + author profile + engagement so the client can render a card without a per-item round trip. Same shape as getCollectionItems.",
      "target_collection": "app.zeens.eventPhoto"
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
