{
  "id": "app.standard-reader.getUserSubscriptions",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "ref": "app.standard-reader.defs#cursorPagePublications",
          "type": "ref"
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "maximum": 50,
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "description": "Publications a DID subscribes to, most recently subscribed first, with cursor pagination."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
