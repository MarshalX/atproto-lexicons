{
  "id": "app.standard-reader.getPublicationDocuments",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "ref": "app.standard-reader.defs#cursorPageDocuments",
          "type": "ref"
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "publication"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "default": 20,
            "maximum": 50,
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "maxLength": 8192
          },
          "publication": {
            "type": "string",
            "format": "at-uri"
          }
        }
      },
      "description": "Chronological article feed for a single publication with cursor pagination."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
