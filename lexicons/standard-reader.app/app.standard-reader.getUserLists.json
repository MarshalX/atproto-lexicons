{
  "id": "app.standard-reader.getUserLists",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "lists"
          ],
          "properties": {
            "lists": {
              "type": "array",
              "items": {
                "ref": "app.standard-reader.defs#listView",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "did"
        ],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "description": "Every publication list authored by a DID, each with its member publications resolved."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
