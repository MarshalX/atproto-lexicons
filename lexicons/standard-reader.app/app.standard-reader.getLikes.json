{
  "id": "app.standard-reader.getLikes",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "ref": "app.standard-reader.defs#cursorPageDocuments",
          "type": "ref"
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          },
          "limit": {
            "type": "integer",
            "default": 20
          },
          "cursor": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "description": "Subject reader liked articles."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
