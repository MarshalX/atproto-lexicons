                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {
          "limit": {
            "type": "integer",
            "default": 12,
            "maximum": 100,
            "minimum": 1
          },
          "scope": {
