{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Fetch the DNSSEC DS (Delegation Signer) records for a domain to publish to the parent registrar.",
      "errors": [
        {
          "description": "The specified domain was not found or has no DNSSEC keys.",
          "name": "NotFound"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "domain": {
              "type": "string"
            },
            "ds": {
              "items": {
                "properties": {
                  "algorithm": {
                    "type": "integer"
                  },
                  "digest": {
                    "type": "string"
                  },
                  "digestType": {
                    "type": "integer"
                  },
                  "keyTag": {
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "domain",
            "ds"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "domain": {
            "description": "The fully qualified domain name.",
            "maxLength": 253,
            "type": "string"
          }
        },
        "required": [
          "domain"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "description": "Get the DNSSEC DS records for a managed zone.",
  "id": "at.marque.dns.getDsRecords",
  "lexicon": 1
}
