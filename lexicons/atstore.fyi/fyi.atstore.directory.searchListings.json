{
  "id": "fyi.atstore.directory.searchListings",
  "defs": {
    "main": {
      "type": "query",
      "errors": [
        {
          "name": "InvalidCursor"
        }
      ],
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "listings"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "maxLength": 512
            },
            "listings": {
              "type": "array",
              "items": {
                "ref": "#listingCardSearch",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 512
          },
          "has": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32,
              "knownValues": [
                "open-source",
                "donations",
                "official"
              ]
            },
            "maxLength": 3,
            "description": "Required extras (all): open-source (has a source link), donations (has a donate link), official (has a product account)."
          },
          "tag": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "maxLength": 20,
            "description": "App tags to match (any). Accepts the tag text from appTags or its slug, e.g. 'developer tool' or 'developer'."
          },
          "data": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "maxLength": 20,
            "description": "Lexicon producers whose records the listing reads or writes (any), as the first two NSID segments, e.g. 'app.bsky'."
          },
          "sort": {
            "enum": [
              "popular",
              "rating",
              "reviews",
              "favorites",
              "newest",
              "updated",
              "alphabetical"
            ],
            "type": "string",
            "default": "popular",
            "maxLength": 24,
            "description": "popular = trending score; rating = average rating (unrated last); reviews = review count; favorites = favorite count; newest = created; updated = last updated; alphabetical = name."
          },
          "limit": {
            "type": "integer",
            "default": 24,
            "maximum": 100,
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "category": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 512
            },
            "maxLength": 20,
            "description": "Category paths to match (any), including descendants, e.g. 'apps/bluesky' or 'apps/bluesky/client'. 'apps' matches top-level apps only."
          },
          "minRating": {
            "type": "string",
            "maxLength": 8,
            "description": "Only listings with an average rating at or above this value.",
            "knownValues": [
              "3",
              "4",
              "4.5"
            ]
          }
        }
      },
      "description": "Directory listing search and pagination (verified listings with a listing.detail AT URI only). Filters match the at-store /apps page: values within one filter are OR'd, different filters are AND'd."
    },
    "listingCardSearch": {
      "type": "object",
      "nullable": [
        "iconUrl",
        "heroImageUrl",
        "categorySlug",
        "rating",
        "productAccountHandle"
      ],
      "required": [
        "uri",
        "name",
        "tagline",
        "description",
        "category",
        "accent",
        "reviewCount",
        "priceLabel",
        "appTags",
        "categorySlugs",
        "iconUrl",
        "heroImageUrl",
        "categorySlug",
        "rating",
        "productAccountHandle"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "maxLength": 2560,
          "description": "AT URI of the listing record: fyi.atstore.listing.detail for apps, games.atmosphere.define for games. Use as the subject of fyi.atstore.listing.review."
        },
        "name": {
          "type": "string",
          "maxLength": 640
        },
        "accent": {
          "type": "string",
          "maxLength": 16,
          "knownValues": [
            "blue",
            "pink",
            "purple",
            "green"
          ]
        },
        "rating": {
          "type": "string",
          "maxLength": 16
        },
        "appTags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "iconUrl": {
          "type": "string",
          "maxLength": 8192
        },
        "tagline": {
          "type": "string",
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "maxLength": 640
        },
        "priceLabel": {
          "type": "string",
          "maxLength": 32
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        },
        "listingType": {
          "type": "string",
          "maxLength": 32,
          "description": "app for AT Store listings; game when the listing is (or is linked to) a games.atmosphere.define record from atmosphere.games.",
          "knownValues": [
            "app",
            "game"
          ]
        },
        "reviewCount": {
          "type": "integer"
        },
        "categorySlug": {
          "type": "string",
          "maxLength": 512
        },
        "heroImageUrl": {
          "type": "string",
          "maxLength": 8192
        },
        "categorySlugs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "productAccountHandle": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
