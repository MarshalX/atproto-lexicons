{
  "id": "buzz.bookhive.resyncAccount",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "properties": {}
        },
        "encoding": "application/json"
      },
      "errors": [
        {
          "name": "ResyncFailed",
          "description": "Re-sync failed; retry manually."
        }
      ],
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "success"
          ],
          "properties": {
            "success": {
              "type": "boolean",
              "const": true
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "Re-sync BookHive book records from the signed-in user's PDS. Requires a live OAuth session; service auth is not sufficient. Completes before returning success. Accepts only an empty JSON object."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
