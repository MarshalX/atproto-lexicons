{
  "id": "buzz.bookhive.getLanguages",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "languages"
          ],
          "properties": {
            "languages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Alphabetically sorted list of available languages with at least 5 books."
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "properties": {}
      },
      "description": "Get the list of available book languages."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
