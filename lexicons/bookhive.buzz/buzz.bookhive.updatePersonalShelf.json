{
  "id": "buzz.bookhive.updatePersonalShelf",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "description": "ID of the shelf to update"
            },
            "name": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "description": "New name for the shelf"
            },
            "description": {
              "type": "string",
              "maxLength": 500,
              "description": "New description for the shelf"
            }
          }
        },
        "encoding": "application/json"
      },
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "shelf"
          ],
          "properties": {
            "shelf": {
              "ref": "buzz.bookhive.createPersonalShelf#personalShelfView",
              "type": "ref"
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "Update an existing personal shelf."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
