{
  "id": "social.colibri.beta.actor.spaceNotification",
  "defs": {
    "main": {
      "key": "any",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "level",
          "createdAt"
        ],
        "properties": {
          "level": {
            "type": "string",
            "description": "Which messages in this community produce a notification.",
            "knownValues": [
              "all",
              "mentionsAndReplies",
              "nothing"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the level was set."
          }
        }
      },
      "description": "A notification level for one community, overriding the level in social.colibri.beta.actor.settings. The record key is the community's DID. Deleting the record returns the community to the global level."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
