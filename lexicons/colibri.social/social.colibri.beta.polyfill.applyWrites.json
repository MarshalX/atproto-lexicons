{
  "id": "social.colibri.beta.polyfill.applyWrites",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "required": [
            "space",
            "writes"
          ],
          "properties": {
            "space": {
              "type": "string",
              "format": "space-ref",
              "description": "The space holding the repo."
            },
            "writes": {
              "type": "array",
              "items": {
                "refs": [
                  "#create",
                  "#update",
                  "#delete"
                ],
                "type": "union",
                "closed": true
              },
              "maxLength": 200,
              "minLength": 1,
              "description": "The writes, applied in order as one revision."
            }
          }
        },
        "encoding": "application/json"
      },
      "errors": [
        {
          "name": "AuthRequired",
          "description": "The request has no valid service auth."
        },
        {
          "name": "InvalidRequest",
          "description": "The arguments are inconsistent or malformed beyond schema validation."
        },
        {
          "name": "SpaceNotFound",
          "description": "No space matches the given space reference."
        },
        {
          "name": "NotAuthorized",
          "description": "The caller may not write to or read from this repo in the space."
        },
        {
          "name": "RepoNotHosted",
          "description": "The AppView does not host the caller's repo in this space, because it lives on the caller's PDS. Write to the PDS instead."
        },
        {
          "name": "InvalidRecord",
          "description": "A record failed validation against its lexicon."
        },
        {
          "name": "RecordNotFound",
          "description": "An update or delete names a record that does not exist."
        }
      ],
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "results",
            "rev"
          ],
          "properties": {
            "rev": {
              "type": "string",
              "format": "tid",
              "description": "The repo revision after the writes."
            },
            "results": {
              "type": "array",
              "items": {
                "refs": [
                  "#createResult",
                  "#updateResult",
                  "#deleteResult"
                ],
                "type": "union",
                "closed": true
              },
              "description": "One result per write, in the same order."
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "Writes records to the requesting user's repo in a space the AppView hosts for them. The write is authorized the way the space's authority would authorize it, stored, and indexed like a synced write. Records keep the URIs they will have on the user's PDS after a migration."
    },
    "create": {
      "type": "object",
      "required": [
        "collection",
        "value"
      ],
      "properties": {
        "rkey": {
          "type": "string",
          "format": "record-key",
          "description": "Defaults to a new TID."
        },
        "value": {
          "type": "unknown",
          "description": "The record itself."
        },
        "collection": {
          "type": "string",
          "format": "nsid",
          "description": "The record's collection."
        }
      },
      "description": "Creates a record."
    },
    "delete": {
      "type": "object",
      "required": [
        "collection",
        "rkey"
      ],
      "properties": {
        "rkey": {
          "type": "string",
          "format": "record-key",
          "description": "The record key."
        },
        "collection": {
          "type": "string",
          "format": "nsid",
          "description": "The record's collection."
        }
      },
      "description": "Deletes a record."
    },
    "update": {
      "type": "object",
      "required": [
        "collection",
        "rkey",
        "value"
      ],
      "properties": {
        "rkey": {
          "type": "string",
          "format": "record-key",
          "description": "The record key."
        },
        "value": {
          "type": "unknown",
          "description": "The record itself."
        },
        "collection": {
          "type": "string",
          "format": "nsid",
          "description": "The record's collection."
        }
      },
      "description": "Replaces a record."
    },
    "createResult": {
      "type": "object",
      "required": [
        "uri",
        "cid"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "The CID of the record or blob."
        },
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The record's URI, the same one it keeps after a migration."
        }
      },
      "description": "The outcome of a create."
    },
    "deleteResult": {
      "type": "object",
      "properties": {},
      "description": "The outcome of a delete."
    },
    "updateResult": {
      "type": "object",
      "required": [
        "uri",
        "cid"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "The CID of the record or blob."
        },
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The record's URI, the same one it keeps after a migration."
        }
      },
      "description": "The outcome of an update."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
