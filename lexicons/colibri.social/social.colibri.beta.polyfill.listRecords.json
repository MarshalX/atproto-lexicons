{
  "id": "social.colibri.beta.polyfill.listRecords",
  "defs": {
    "main": {
      "type": "query",
      "errors": [
        {
          "name": "AuthRequired",
          "description": "The request has no valid service auth."
        },
        {
          "name": "InvalidRequest",
          "description": "The arguments are inconsistent or malformed beyond schema validation."
        },
        {
          "name": "SpaceNotFound",
          "description": "No space matches the given space reference."
        },
        {
          "name": "NotAuthorized",
          "description": "The caller may not write to or read from this repo in the space."
        },
        {
          "name": "RepoNotHosted",
          "description": "The AppView does not host the caller's repo in this space, because it lives on the caller's PDS. Write to the PDS instead."
        }
      ],
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "records"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "description": "Where the next page starts."
            },
            "records": {
              "type": "array",
              "items": {
                "ref": "social.colibri.beta.polyfill.defs#recordView",
                "type": "ref"
              },
              "description": "The records on this page."
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "space",
          "collection"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "description": "The page size."
          },
          "space": {
            "type": "string",
            "format": "space-ref",
            "description": "The space holding the repo."
          },
          "cursor": {
            "type": "string",
            "description": "Where the next page starts."
          },
          "reverse": {
            "type": "boolean",
            "description": "Newest record key first."
          },
          "collection": {
            "type": "string",
            "format": "nsid",
            "description": "The record's collection."
          }
        }
      },
      "description": "Lists records of one collection in the requesting user's repo in a space the AppView hosts for them, ordered by record key."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
