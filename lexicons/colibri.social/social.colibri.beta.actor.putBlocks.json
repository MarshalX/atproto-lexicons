{
  "id": "social.colibri.beta.actor.putBlocks",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "required": [
            "blocks"
          ],
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "ref": "social.colibri.beta.actor.defs#block",
                "type": "ref"
              },
              "description": "The complete, replacement block list."
            }
          }
        },
        "encoding": "application/json"
      },
      "errors": [
        {
          "name": "AuthRequired",
          "description": "The request has no valid service auth."
        }
      ],
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "preferences"
          ],
          "properties": {
            "preferences": {
              "ref": "social.colibri.beta.actor.defs#preferences",
              "type": "ref",
              "description": "The requesting user's settings, after the update."
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "Pushes the requesting user's block list to the AppView, so it takes effect immediately instead of waiting for a sync notification. The client writes the underlying block records to its own personal space first, then calls this. The list replaces the AppView's whole copy."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
