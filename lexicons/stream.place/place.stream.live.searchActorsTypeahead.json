{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "actor": {
      "properties": {
        "did": {
          "description": "The actor's DID",
          "format": "did",
          "type": "string"
        },
        "handle": {
          "description": "The actor's handle",
          "format": "handle",
          "type": "string"
        }
      },
      "required": [
        "did",
        "handle"
      ],
      "type": "object"
    },
    "main": {
      "description": "Find actor suggestions for a prefix search term. Expected use is for auto-completion during text field entry.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "actors": {
              "items": {
                "ref": "#actor",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": [
            "actors"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "limit": {
            "default": 10,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "q": {
            "description": "Search query prefix; not a full query string.",
            "type": "string"
          }
        },
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "place.stream.live.searchActorsTypeahead",
  "lexicon": 1
}
