{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Get a list of livestream segments for a user",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "streams": {
              "items": {
                "ref": "place.stream.livestream#livestreamView",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "before": {
            "format": "datetime",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "place.stream.live.getLiveUsers",
  "lexicon": 1
}
