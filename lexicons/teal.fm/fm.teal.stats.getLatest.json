{
  "id": "fm.teal.stats.getLatest",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "plays"
          ],
          "properties": {
            "plays": {
              "type": "array",
              "items": {
                "ref": "fm.teal.feed.defs#playView",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "description": "Number of latest plays to return"
          }
        }
      },
      "description": "Get latest plays globally"
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
