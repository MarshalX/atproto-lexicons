{
  "id": "social.pinkleap.preferences",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "slug",
          "value",
          "createdAt"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 255
          },
          "value": {
            "type": "string",
            "maxLength": 255
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      },
      "description": "Record describing a private Pinkleap app preference (own-session settings, not exposed on the public profile)."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
