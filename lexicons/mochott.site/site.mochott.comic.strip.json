{
  "id": "site.mochott.comic.strip",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "series",
          "createdAt",
          "images"
        ],
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "ref": "site.mochott.comic.defs#tag",
              "type": "ref"
            },
            "maxLength": 10,
            "description": "Free-form tags."
          },
          "title": {
            "type": "array",
            "items": {
              "ref": "site.mochott.comic.defs#localizedTitle",
              "type": "ref"
            },
            "maxLength": 100,
            "description": "Strip title, one entry per language."
          },
          "topic": {
            "type": "string",
            "maxLength": 100,
            "description": "Slug of the mochott writing topic (投稿のお題) this work participates in."
          },
          "images": {
            "type": "array",
            "items": {
              "ref": "site.mochott.comic.defs#localizedImage",
              "type": "ref"
            },
            "maxLength": 100,
            "minLength": 1,
            "description": "Final artwork, one entry per language."
          },
          "labels": {
            "refs": [
              "com.atproto.label.defs#selfLabels"
            ],
            "type": "union",
            "description": "Self-labels for this chapter or strip alone. work.sequential only labels whole series; mochott applies these in addition to the series labels."
          },
          "panels": {
            "type": "array",
            "items": {
              "ref": "site.mochott.comic.defs#panel",
              "type": "ref"
            },
            "maxLength": 100,
            "description": "Panels in reading order."
          },
          "series": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the parent site.mochott.comic.series."
          },
          "credits": {
            "type": "array",
            "items": {
              "ref": "site.mochott.comic.defs#credit",
              "type": "ref"
            },
            "maxLength": 100,
            "description": "People who worked on the strip."
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "description": "mochott platform category slug, used to list the work alongside articles."
          },
          "versions": {
            "type": "array",
            "items": {
              "ref": "site.mochott.comic.defs#version",
              "type": "ref"
            },
            "maxLength": 50,
            "description": "Other versions of the same artwork, such as production stages."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Publish date and sort order of the strip."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the strip was last updated."
          },
          "sequential": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the canonical work.sequential record this record accompanies. Same record key. Omitted only when the work exists solely in this namespace."
          },
          "aspectRatio": {
            "ref": "site.mochott.comic.defs#aspectRatio",
            "type": "ref",
            "description": "Aspect ratio of the artwork."
          },
          "minisiteCategory": {
            "ref": "site.mochott.comic.defs#minisiteCategory",
            "type": "ref",
            "description": "Category of the work within a mochott minisite."
          }
        }
      },
      "description": "A comic strip."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "revision": 2,
  "description": "A comic strip on mochott. Written beside the work.sequential.strip of the same record key as a complete copy that also holds mochott extensions."
}
