{
  "id": "site.mochott.notification.updateSeen",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "properties": {
            "seenAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        },
        "encoding": "application/json"
      },
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "success"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "With seenAt, marks read the unread notifications created at or before seenAt, compared to the millisecond. Without a body or without seenAt, marks every unread notification read."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "revision": 1,
  "description": "Mark notifications of the requesting account as read. Requires auth."
}
