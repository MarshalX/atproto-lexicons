{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "A user's profile on atnime.",
      "key": "literal:self",
      "record": {
        "properties": {
          "accentColor": {
            "description": "User profile's accent color. Falls back to knownValues index 0.",
            "knownValues": [
              "red",
              "purple",
              "blue",
              "green",
              "pink",
              "yellow",
              "orange"
            ],
            "type": "string"
          },
          "avatar": {
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "maxSize": 1000000,
            "type": "blob"
          },
          "createdAt": {
            "format": "datetime",
            "type": "string"
          },
          "displayName": {
            "maxGraphemes": 64,
            "maxLength": 640,
            "type": "string"
          },
          "location": {
            "description": "Free-form location text.",
            "maxGraphemes": 70,
            "maxLength": 700,
            "type": "string"
          },
          "pronouns": {
            "description": "Free-form pronouns text.",
            "maxGraphemes": 20,
            "maxLength": 200,
            "type": "string"
          },
          "syncFrom": {
            "description": "Makes the user's profile use another record over this one.",
            "knownValues": [
              "bsky",
              "tangled"
            ],
            "type": "string"
          }
        },
        "required": [
          "createdAt"
        ],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "me.atni.actor.profile",
  "lexicon": 1
}
