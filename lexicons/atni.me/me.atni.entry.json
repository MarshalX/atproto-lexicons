{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "A user's relation/status to a work.",
      "key": "tid",
      "record": {
        "properties": {
          "createdAt": {
            "format": "datetime",
            "type": "string"
          },
          "notes": {
            "description": "Free-form notes.",
            "maxGraphemes": 2000,
            "maxLength": 6000,
            "type": "string"
          },
          "progress": {
            "description": "eps watched in current pass, set to 0 on rewatch",
            "minimum": 0,
            "type": "integer"
          },
          "rewatches": {
            "description": "0 = first watch, increments as soon as rewatch starts",
            "minimum": 0,
            "type": "integer"
          },
          "score": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "ref": "me.atni.defs#status",
            "type": "ref"
          },
          "subject": {
            "refs": [
              "me.atni.defs#animeId"
            ],
            "type": "union"
          },
          "updatedAt": {
            "format": "datetime",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "status",
          "createdAt"
        ],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "me.atni.entry",
  "lexicon": 1
}
