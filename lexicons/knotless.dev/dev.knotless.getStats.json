{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "day": {
      "description": "One day, in UTC, as anyone sees it.",
      "properties": {
        "authors": {
          "description": "Accounts that made a repository, pushed, or wrote in a thread.",
          "minimum": 0,
          "type": "integer"
        },
        "checks": {
          "description": "Check runs started.",
          "minimum": 0,
          "type": "integer"
        },
        "comments": {
          "minimum": 0,
          "type": "integer"
        },
        "day": {
          "description": "YYYY-MM-DD.",
          "type": "string"
        },
        "issues": {
          "minimum": 0,
          "type": "integer"
        },
        "pulls": {
          "minimum": 0,
          "type": "integer"
        },
        "pushes": {
          "minimum": 0,
          "type": "integer"
        },
        "repos": {
          "description": "Repositories made, from the index.",
          "minimum": 0,
          "type": "integer"
        },
        "views": {
          "description": "Pages they drew.",
          "minimum": 0,
          "type": "integer"
        },
        "visitors": {
          "description": "People whose browsers drew a page, each once.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "day",
        "visitors",
        "views",
        "repos",
        "pushes",
        "pulls",
        "issues",
        "comments",
        "checks",
        "authors"
      ],
      "type": "object"
    },
    "main": {
      "description": "What an appview shows anyone of how it is used: the network as its index has it now, and each of the last 30 days, what the network wrote in it and how many people drew its pages (by a hash forgotten each day). Its operators read the rest with dev.knotless.getUsage.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "days": {
              "description": "The last 30 days, oldest first, today (UTC) the last.",
              "items": {
                "ref": "#day",
                "type": "ref"
              },
              "type": "array"
            },
            "network": {
              "description": "Absent where the appview keeps no index.",
              "ref": "dev.knotless.getUsage#network",
              "type": "ref"
            }
          },
          "required": [
            "days"
          ],
          "type": "object"
        }
      },
      "type": "query"
    }
  },
  "id": "dev.knotless.getStats",
  "lexicon": 1
}
