{
  "id": "dev.knotless.listReports",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "reports"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "reports": {
              "type": "array",
              "items": {
                "ref": "#report",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 500,
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "description": "A report id: those before it."
          }
        }
      },
      "description": "The reports a moderation service was sent (com.atproto.moderation.createReport), newest first. For its operators: it takes a service token for this method from one of the accounts it names as its operators, or the session cookie of one logged in to its pages."
    },
    "report": {
      "type": "object",
      "required": [
        "id",
        "reasonType",
        "subject",
        "reportedBy",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "reason": {
          "type": "string",
          "maxLength": 20000,
          "maxGraphemes": 2000
        },
        "subject": {
          "refs": [
            "com.atproto.admin.defs#repoRef",
            "com.atproto.repo.strongRef"
          ],
          "type": "union"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "reasonType": {
          "ref": "com.atproto.moderation.defs#reasonType",
          "type": "ref"
        },
        "reportedBy": {
          "type": "string",
          "format": "did"
        }
      },
      "description": "As com.atproto.moderation.createReport answered it."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
