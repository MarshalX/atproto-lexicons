{
  "id": "dev.knotless.searchOwners",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "owners"
          ],
          "properties": {
            "owners": {
              "type": "array",
              "items": {
                "ref": "#ownerView",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "q"
        ],
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 100,
            "description": "Text the handle holds."
          },
          "limit": {
            "type": "integer",
            "default": 10,
            "maximum": 50,
            "minimum": 1
          }
        }
      },
      "description": "Accounts owning public repositories an appview has indexed, whose handle holds the query, ignoring case: those it starts with first, then by their newest repository. No authentication; responses are not personalized."
    },
    "ownerView": {
      "type": "object",
      "required": [
        "owner",
        "repoCount"
      ],
      "properties": {
        "owner": {
          "ref": "dev.knotless.defs#actorView",
          "type": "ref"
        },
        "repoCount": {
          "type": "integer",
          "minimum": 1,
          "description": "How many public repositories the account owns, as the appview has indexed them."
        }
      },
      "description": "An account, with how many public repositories it owns."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "description": "Accounts owning public repositories an appview has indexed, found by handle."
}
