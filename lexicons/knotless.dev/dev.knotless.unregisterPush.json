{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Forgets a device of the asking account. A token it does not hold changes nothing.",
      "errors": [
        {
          "description": "No account is asking.",
          "name": "AuthenticationRequired"
        }
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "token": {
              "description": "The device's push token from Apple, in hexadecimal.",
              "maxLength": 200,
              "type": "string"
            }
          },
          "required": [
            "token"
          ],
          "type": "object"
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {},
          "type": "object"
        }
      },
      "type": "procedure"
    }
  },
  "description": "Asks this appview to stop sending the asking account's notifications to a device.",
  "id": "dev.knotless.unregisterPush",
  "lexicon": 1
}
