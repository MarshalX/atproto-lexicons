{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "For a private repository, written in the author's repo inside the repository's space.",
      "key": "tid",
      "record": {
        "properties": {
          "attachments": {
            "description": "What it carries beside its body: the pictures the body shows. Kinds unknown to a reader are passed over, and kept by a client changing it.",
            "items": {
              "refs": [
                "dev.knotless.defs#image"
              ],
              "type": "union"
            },
            "maxLength": 32,
            "type": "array"
          },
          "body": {
            "description": "Markdown.",
            "maxLength": 20000,
            "type": "string"
          },
          "createdAt": {
            "format": "datetime",
            "type": "string"
          },
          "facets": {
            "description": "The accounts its body mentions, by where: written as it is, from each `@handle` outside code and links.",
            "items": {
              "ref": "dev.knotless.defs#facet",
              "type": "ref"
            },
            "maxLength": 50,
            "type": "array"
          },
          "repo": {
            "description": "The target repository.",
            "ref": "dev.knotless.defs#repoRef",
            "type": "ref"
          },
          "title": {
            "maxGraphemes": 300,
            "maxLength": 3000,
            "type": "string"
          },
          "titleFacets": {
            "description": "The accounts its title mentions, by where.",
            "items": {
              "ref": "dev.knotless.defs#facet",
              "type": "ref"
            },
            "maxLength": 50,
            "type": "array"
          },
          "updatedAt": {
            "description": "When its author last changed its title or body.",
            "format": "datetime",
            "type": "string"
          }
        },
        "required": [
          "repo",
          "title",
          "createdAt"
        ],
        "type": "object"
      },
      "type": "record"
    }
  },
  "description": "An issue on a repository, kept in its author's account.",
  "id": "dev.knotless.issue",
  "lexicon": 1
}
