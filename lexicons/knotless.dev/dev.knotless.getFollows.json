{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "The accounts the account's dev.knotless.follow records name, as the appview has indexed them, the latest followed first. An account taken down is left out. No authentication; responses are not personalized.",
      "errors": [
        {
          "description": "No account by that DID or handle.",
          "name": "ProfileNotFound"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "actors": {
              "items": {
                "ref": "dev.knotless.defs#actorView",
                "type": "ref"
              },
              "type": "array"
            },
            "cursor": {
              "description": "Absent on the last page.",
              "type": "string"
            }
          },
          "required": [
            "actors"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "actor": {
            "description": "The account, by DID or handle.",
            "format": "at-identifier",
            "type": "string"
          },
          "cursor": {
            "description": "Where the page before ended.",
            "maxLength": 512,
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "actor"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "description": "The accounts an account follows on knotless.",
  "id": "dev.knotless.getFollows",
  "lexicon": 1
}
