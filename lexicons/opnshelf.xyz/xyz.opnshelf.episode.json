{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "A tracked show episode record for Opnshelf",
      "key": "tid",
      "record": {
        "properties": {
          "createdAt": {
            "description": "Record creation timestamp",
            "format": "datetime",
            "type": "string"
          },
          "episodeNumber": {
            "description": "TMDB episode number",
            "type": "integer"
          },
          "seasonNumber": {
            "description": "TMDB season number",
            "type": "integer"
          },
          "showId": {
            "description": "TMDB show ID",
            "type": "string"
          },
          "source": {
            "description": "Source of the show data (e.g., tmdb)",
            "type": "string"
          },
          "watchedAt": {
            "description": "When the episode was watched",
            "format": "datetime",
            "type": "string"
          }
        },
        "required": [
          "showId",
          "seasonNumber",
          "episodeNumber",
          "source",
          "createdAt"
        ],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "xyz.opnshelf.episode",
  "lexicon": 1
}
