{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "followingItem": {
      "properties": {
        "avatar": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "viewer": {
          "ref": "social.grain.unspecced.getFollowing#viewerState",
          "type": "ref"
        }
      },
      "required": [
        "did"
      ],
      "type": "object"
    },
    "main": {
      "description": "Get users that a given user follows.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "cursor": {
              "type": "string"
            },
            "items": {
              "items": {
                "ref": "social.grain.unspecced.getFollowing#followingItem",
                "type": "ref"
              },
              "type": "array"
            },
            "totalCount": {
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "actor": {
            "format": "at-identifier",
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "viewer": {
            "format": "did",
            "type": "string"
          }
        },
        "required": [
          "actor"
        ],
        "type": "params"
      },
      "type": "query"
    },
    "viewerState": {
      "properties": {
        "following": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.getFollowing",
  "lexicon": 1
}
