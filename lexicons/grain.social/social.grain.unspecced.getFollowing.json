{
  "id": "social.grain.unspecced.getFollowing",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "ref": "social.grain.unspecced.getFollowing#followingItem",
                "type": "ref"
              }
            },
            "cursor": {
              "type": "string"
            },
            "totalCount": {
              "type": "integer"
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "actor"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "format": "at-identifier"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          },
          "cursor": {
            "type": "string"
          },
          "viewer": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "description": "Get users that a given user follows."
    },
    "viewerState": {
      "type": "object",
      "properties": {
        "following": {
          "type": "string",
          "format": "at-uri"
        }
      }
    },
    "followingItem": {
      "type": "object",
      "required": [
        "did"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "avatar": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "viewer": {
          "ref": "social.grain.unspecced.getFollowing#viewerState",
          "type": "ref"
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
