{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Favourite, or unfavourite, a gallery in a group's pool. The record is the viewer's own, written into the pool rather than their public repo: in the public repo it would name a private gallery to the whole network.",
      "errors": [
        {
          "description": "The viewer is not a member of this pool.",
          "name": "NotAuthorized"
        }
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "gallery": {
              "description": "The gallery being favourited, by the uri it would have in its author's repo.",
              "format": "at-uri",
              "type": "string"
            },
            "group": {
              "format": "did",
              "type": "string"
            },
            "on": {
              "type": "boolean"
            }
          },
          "required": [
            "group",
            "gallery",
            "on"
          ],
          "type": "object"
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "on": {
              "type": "boolean"
            },
            "rkey": {
              "description": "The favourite record, when there is one.",
              "type": "string"
            }
          },
          "required": [
            "on"
          ],
          "type": "object"
        }
      },
      "type": "procedure"
    }
  },
  "id": "social.grain.unspecced.putPoolFavorite",
  "lexicon": 1
}
