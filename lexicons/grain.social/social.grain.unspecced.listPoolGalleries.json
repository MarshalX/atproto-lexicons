{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Every gallery in a group's pool, newest first. Assembled at request time from the repos of the members who wrote them — a pool space never reaches a firehose, so none of it is in the index — and readable only by a member the group's host issues a credential to.",
      "errors": [
        {
          "description": "The viewer is not a member of this pool.",
          "name": "NotAuthorized"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "galleries": {
              "items": {
                "ref": "#poolGallery",
                "type": "ref"
              },
              "type": "array"
            },
            "space": {
              "type": "string"
            }
          },
          "required": [
            "space",
            "galleries"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "group": {
            "format": "did",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "group"
        ],
        "type": "params"
      },
      "type": "query"
    },
    "poolGallery": {
      "properties": {
        "avatar": {
          "description": "The author's Grain profile picture, a public record of their own.",
          "type": "string"
        },
        "commentCount": {
          "type": "integer"
        },
        "cover": {
          "ref": "social.grain.unspecced.getPrivateGallery#privateItem",
          "type": "ref"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "description": "Whose gallery it is.",
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "favCount": {
          "type": "integer"
        },
        "handle": {
          "type": "string"
        },
        "photoCount": {
          "type": "integer"
        },
        "rkey": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "description": "What a favourite or a comment names.",
          "format": "at-uri",
          "type": "string"
        },
        "viewerFav": {
          "type": "string"
        }
      },
      "required": [
        "space",
        "did",
        "rkey",
        "title",
        "photoCount"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.listPoolGalleries",
  "lexicon": 1
}
