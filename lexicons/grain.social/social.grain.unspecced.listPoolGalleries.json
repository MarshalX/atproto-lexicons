{
  "id": "social.grain.unspecced.listPoolGalleries",
  "defs": {
    "main": {
      "type": "query",
      "errors": [
        {
          "name": "NotAuthorized",
          "description": "The viewer is not a member of this pool."
        }
      ],
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "space",
            "galleries"
          ],
          "properties": {
            "space": {
              "type": "string"
            },
            "galleries": {
              "type": "array",
              "items": {
                "ref": "#poolGallery",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "group"
        ],
        "properties": {
          "group": {
            "type": "string",
            "format": "did"
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          }
        }
      },
      "description": "Every gallery in a group's pool, newest first. Assembled at request time from the repos of the members who wrote them — a pool space never reaches a firehose, so none of it is in the index — and readable only by a member the group's host issues a credential to."
    },
    "poolGallery": {
      "type": "object",
      "required": [
        "space",
        "did",
        "rkey",
        "title",
        "photoCount"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did",
          "description": "Whose gallery it is."
        },
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "What a favourite or a comment names."
        },
        "rkey": {
          "type": "string"
        },
        "cover": {
          "ref": "social.grain.unspecced.getPrivateGallery#privateItem",
          "type": "ref"
        },
        "space": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "avatar": {
          "type": "string",
          "description": "The author's Grain profile picture, a public record of their own."
        },
        "handle": {
          "type": "string"
        },
        "favCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "viewerFav": {
          "type": "string"
        },
        "photoCount": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "commentCount": {
          "type": "integer"
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
