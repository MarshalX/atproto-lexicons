{
  "id": "social.grain.group.defs",
  "defs": {
    "rule": {
      "type": "object",
      "required": [
        "uri",
        "title"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "groupRef": {
      "type": "object",
      "required": [
        "did",
        "handle",
        "item"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "item": {
          "type": "string",
          "format": "at-uri",
          "description": "The social.grain.group.item that pools this gallery."
        },
        "handle": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "groupView": {
      "type": "object",
      "required": [
        "did",
        "handle"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The group's own site, from its opensocial profile. Where the group is actually run."
        },
        "rules": {
          "type": "array",
          "items": {
            "ref": "#rule",
            "type": "ref"
          }
        },
        "avatar": {
          "type": "string",
          "format": "uri"
        },
        "handle": {
          "type": "string"
        },
        "viewer": {
          "ref": "#viewerState",
          "type": "ref"
        },
        "poolCount": {
          "type": "integer",
          "description": "Galleries in the pool."
        },
        "joinPolicy": {
          "type": "string",
          "description": "How to get in, from the group's public profile.",
          "knownValues": [
            "open",
            "request",
            "invite"
          ]
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "pendingCount": {
          "type": "integer",
          "description": "Submissions awaiting review. Only present for a viewer acting as the group."
        },
        "lastActivityAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the pool last changed."
        }
      }
    },
    "viewerState": {
      "type": "object",
      "properties": {
        "acting": {
          "type": "boolean",
          "description": "The viewer is signed in as this group, so may accept and remove."
        },
        "member": {
          "type": "boolean",
          "description": "The viewer has accepted membership of this group, as their own PDS lists it. A claim, not access: the host decides that."
        },
        "submission": {
          "ref": "#submissionState",
          "type": "ref",
          "description": "The viewer's standing for the gallery named in the request, if one was."
        }
      }
    },
    "submissionView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "group",
        "gallery",
        "createdAt"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "group": {
          "type": "string",
          "format": "did"
        },
        "gallery": {
          "ref": "social.grain.gallery.defs#galleryView",
          "type": "ref"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "submissionState": {
      "type": "object",
      "required": [
        "uri",
        "status"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "The submission record."
        },
        "item": {
          "type": "string",
          "format": "at-uri",
          "description": "The group's item record, once accepted."
        },
        "status": {
          "type": "string",
          "knownValues": [
            "pending",
            "accepted",
            "declined"
          ]
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
