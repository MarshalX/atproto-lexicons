{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "galleryItem": {
      "properties": {
        "alt": {
          "type": "string"
        },
        "aspectRatio": {
          "ref": "social.grain.defs#aspectRatio",
          "type": "ref"
        },
        "cid": {
          "description": "Blob CID. Fetch through the space, never the CDN.",
          "format": "cid",
          "type": "string"
        },
        "did": {
          "description": "Repo holding the photo, and its blob.",
          "format": "did",
          "type": "string"
        },
        "position": {
          "type": "integer"
        },
        "uri": {
          "description": "Space URI of the photo record.",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "did",
        "cid",
        "position"
      ],
      "type": "object"
    },
    "galleryRecord": {
      "properties": {
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "title"
      ],
      "type": "object"
    },
    "groupRef": {
      "properties": {
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "item": {
          "description": "The social.grain.group.item that pools this gallery.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "did",
        "handle",
        "item"
      ],
      "type": "object"
    },
    "groupView": {
      "properties": {
        "avatar": {
          "format": "uri",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "joinPolicy": {
          "description": "How to get in, from the group's public profile.",
          "knownValues": [
            "open",
            "request",
            "invite"
          ],
          "type": "string"
        },
        "lastActivityAt": {
          "description": "When the pool last changed.",
          "format": "datetime",
          "type": "string"
        },
        "pendingCount": {
          "description": "Submissions awaiting review. Only present for a viewer acting as the group.",
          "type": "integer"
        },
        "poolCount": {
          "description": "Galleries in the pool.",
          "type": "integer"
        },
        "rules": {
          "items": {
            "ref": "#rule",
            "type": "ref"
          },
          "type": "array"
        },
        "url": {
          "description": "The group's own site, from its opensocial profile. Where the group is actually run.",
          "format": "uri",
          "type": "string"
        },
        "viewer": {
          "ref": "#viewerState",
          "type": "ref"
        }
      },
      "required": [
        "did",
        "handle"
      ],
      "type": "object"
    },
    "photoInput": {
      "properties": {
        "alt": {
          "type": "string"
        },
        "aspectRatio": {
          "ref": "social.grain.defs#aspectRatio",
          "type": "ref"
        },
        "photo": {
          "accept": [
            "image/*"
          ],
          "maxSize": 1000000,
          "type": "blob"
        }
      },
      "required": [
        "photo",
        "aspectRatio"
      ],
      "type": "object"
    },
    "poolAuthor": {
      "properties": {
        "avatar": {
          "type": "string"
        },
        "avatarThumb": {
          "description": "The avatar drawn small, 144 pixels square, for faces in lines and lists.",
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "did"
      ],
      "type": "object"
    },
    "poolComment": {
      "properties": {
        "author": {
          "ref": "#poolAuthor",
          "type": "ref"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "facets": {
          "items": {
            "ref": "app.bsky.richtext.facet",
            "type": "ref"
          },
          "type": "array"
        },
        "replyTo": {
          "format": "at-uri",
          "type": "string"
        },
        "rkey": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "rkey",
        "text",
        "author"
      ],
      "type": "object"
    },
    "poolFeedItem": {
      "properties": {
        "avatar": {
          "description": "The author's Grain profile picture, a public record of their own.",
          "type": "string"
        },
        "avatarThumb": {
          "description": "The author's Grain profile picture drawn small, 144 pixels square, for faces in lines and lists.",
          "type": "string"
        },
        "commentCount": {
          "type": "integer"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "description": "Whose gallery it is.",
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "favCount": {
          "type": "integer"
        },
        "group": {
          "description": "Whose pool it is in.",
          "format": "did",
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "items": {
          "items": {
            "ref": "#galleryItem",
            "type": "ref"
          },
          "type": "array"
        },
        "photoCount": {
          "type": "integer"
        },
        "rkey": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "description": "What a favourite or a comment names.",
          "format": "at-uri",
          "type": "string"
        },
        "viewerFav": {
          "type": "string"
        }
      },
      "required": [
        "space",
        "group",
        "did",
        "rkey",
        "title",
        "photoCount",
        "items"
      ],
      "type": "object"
    },
    "poolGallery": {
      "properties": {
        "avatar": {
          "description": "The author's Grain profile picture, a public record of their own.",
          "type": "string"
        },
        "avatarThumb": {
          "description": "The author's Grain profile picture drawn small, 144 pixels square, for faces in lines and lists.",
          "type": "string"
        },
        "commentCount": {
          "type": "integer"
        },
        "cover": {
          "ref": "#galleryItem",
          "type": "ref"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "description": "Whose gallery it is.",
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "favCount": {
          "type": "integer"
        },
        "handle": {
          "type": "string"
        },
        "photoCount": {
          "type": "integer"
        },
        "rkey": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "description": "What a favourite or a comment names.",
          "format": "at-uri",
          "type": "string"
        },
        "viewerFav": {
          "type": "string"
        }
      },
      "required": [
        "space",
        "did",
        "rkey",
        "title",
        "photoCount"
      ],
      "type": "object"
    },
    "rule": {
      "properties": {
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "title"
      ],
      "type": "object"
    },
    "submissionState": {
      "properties": {
        "item": {
          "description": "The group's item record, once accepted.",
          "format": "at-uri",
          "type": "string"
        },
        "status": {
          "knownValues": [
            "pending",
            "accepted",
            "declined"
          ],
          "type": "string"
        },
        "uri": {
          "description": "The submission record.",
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "status"
      ],
      "type": "object"
    },
    "submissionView": {
      "properties": {
        "cid": {
          "format": "cid",
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "gallery": {
          "ref": "social.grain.gallery.defs#galleryView",
          "type": "ref"
        },
        "group": {
          "format": "did",
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "cid",
        "group",
        "gallery",
        "createdAt"
      ],
      "type": "object"
    },
    "viewerState": {
      "properties": {
        "acting": {
          "description": "The viewer is signed in as this group, so may accept and remove.",
          "type": "boolean"
        },
        "member": {
          "description": "The viewer has accepted membership of this group, as their own PDS lists it. A claim, not access: the host decides that.",
          "type": "boolean"
        },
        "submission": {
          "description": "The viewer's standing for the gallery named in the request, if one was.",
          "ref": "#submissionState",
          "type": "ref"
        }
      },
      "type": "object"
    }
  },
  "id": "social.grain.group.defs",
  "lexicon": 1
}
