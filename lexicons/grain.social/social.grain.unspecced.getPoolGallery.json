{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "One gallery from a group's pool, read from the repo that holds it through a credential the group's host issues.",
      "errors": [
        {
          "description": "The viewer is not a member of this pool.",
          "name": "NotAuthorized"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "avatar": {
              "type": "string"
            },
            "commentCount": {
              "type": "integer"
            },
            "comments": {
              "items": {
                "ref": "#poolComment",
                "type": "ref"
              },
              "type": "array"
            },
            "did": {
              "format": "did",
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "favCount": {
              "type": "integer"
            },
            "gallery": {
              "ref": "social.grain.unspecced.getPrivateGallery#privateGallery",
              "type": "ref"
            },
            "handle": {
              "type": "string"
            },
            "items": {
              "items": {
                "ref": "social.grain.unspecced.getPrivateGallery#privateItem",
                "type": "ref"
              },
              "type": "array"
            },
            "space": {
              "type": "string"
            },
            "viewerFav": {
              "description": "The rkey of the viewer's own favourite, when they have one.",
              "type": "string"
            },
            "viewerIsAuthor": {
              "type": "boolean"
            }
          },
          "required": [
            "space",
            "did",
            "items"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "did": {
            "description": "Whose gallery it is.",
            "format": "did",
            "type": "string"
          },
          "group": {
            "format": "did",
            "type": "string"
          },
          "rkey": {
            "type": "string"
          }
        },
        "required": [
          "group",
          "did",
          "rkey"
        ],
        "type": "params"
      },
      "type": "query"
    },
    "poolAuthor": {
      "properties": {
        "avatar": {
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "did"
      ],
      "type": "object"
    },
    "poolComment": {
      "properties": {
        "author": {
          "ref": "#poolAuthor",
          "type": "ref"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "facets": {
          "items": {
            "ref": "app.bsky.richtext.facet",
            "type": "ref"
          },
          "type": "array"
        },
        "replyTo": {
          "format": "at-uri",
          "type": "string"
        },
        "rkey": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "rkey",
        "text",
        "author"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.getPoolGallery",
  "lexicon": 1
}
