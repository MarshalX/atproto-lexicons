{
  "id": "social.grain.unspecced.getStoryAuthors",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "authors"
          ],
          "properties": {
            "authors": {
              "type": "array",
              "items": {
                "ref": "social.grain.unspecced.getStoryAuthors#storyAuthor",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "Get authors who have active stories (posted within the last 24 hours)."
    },
    "storyAuthor": {
      "type": "object",
      "required": [
        "profile",
        "storyCount",
        "latestAt"
      ],
      "properties": {
        "profile": {
          "ref": "social.grain.actor.defs#profileView",
          "type": "ref"
        },
        "latestAt": {
          "type": "string",
          "format": "datetime"
        },
        "storyCount": {
          "type": "integer"
        },
        "lastViewedAt": {
          "type": "string",
          "format": "datetime",
          "description": "createdAt of the newest of this author's live stories the requesting account has watched. Compare against latestAt to tell whether the viewer is caught up. Only present for an authenticated viewer who has watched at least one."
        },
        "unviewedCount": {
          "type": "integer",
          "description": "How many of this author's live stories the requesting account has not watched. Only present for an authenticated viewer."
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
