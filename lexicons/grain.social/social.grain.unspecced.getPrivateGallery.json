{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Assemble a gallery that lives in a permissioned space. Read from the repos that hold it at request time — space records never reach a firehose, so none of this is in the index.",
      "errors": [
        {
          "description": "The viewer is not a member of this space.",
          "name": "NotAuthorized"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "authority": {
              "format": "did",
              "type": "string"
            },
            "gallery": {
              "ref": "#privateGallery",
              "type": "ref"
            },
            "items": {
              "items": {
                "ref": "#privateItem",
                "type": "ref"
              },
              "type": "array"
            },
            "space": {
              "type": "string"
            },
            "viewerIsAuthor": {
              "type": "boolean"
            }
          },
          "required": [
            "space",
            "authority",
            "items"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "space": {
            "description": "Space URI: at://<authority>/space/social.grain.privateGallery/<skey>",
            "type": "string"
          }
        },
        "required": [
          "space"
        ],
        "type": "params"
      },
      "type": "query"
    },
    "privateGallery": {
      "properties": {
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "title"
      ],
      "type": "object"
    },
    "privateItem": {
      "properties": {
        "alt": {
          "type": "string"
        },
        "aspectRatio": {
          "ref": "social.grain.defs#aspectRatio",
          "type": "ref"
        },
        "cid": {
          "description": "Blob CID. Fetch through the space, never the CDN.",
          "format": "cid",
          "type": "string"
        },
        "did": {
          "description": "Repo holding the photo, and its blob.",
          "format": "did",
          "type": "string"
        },
        "position": {
          "type": "integer"
        },
        "uri": {
          "description": "Space URI of the photo record.",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "did",
        "cid",
        "position"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.getPrivateGallery",
  "lexicon": 1
}
