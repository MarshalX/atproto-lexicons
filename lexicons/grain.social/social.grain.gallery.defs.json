{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "cameraItem": {
      "properties": {
        "camera": {
          "type": "string"
        },
        "photoCount": {
          "type": "integer"
        },
        "thumbs": {
          "description": "Up to four representative photo thumbnails, most recent first. Lets the index render without a feed request per camera.",
          "items": {
            "format": "uri",
            "type": "string"
          },
          "maxLength": 4,
          "type": "array"
        }
      },
      "required": [
        "camera",
        "photoCount"
      ],
      "type": "object"
    },
    "crossPostInfo": {
      "properties": {
        "url": {
          "description": "URL to the cross-posted Bluesky post.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "favoriteItem": {
      "properties": {
        "avatar": {
          "type": "string"
        },
        "avatarThumb": {
          "description": "The avatar drawn small, 144 pixels square, for faces in lines and lists.",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "viewer": {
          "ref": "social.grain.actor.defs#viewerState",
          "type": "ref"
        }
      },
      "required": [
        "did"
      ],
      "type": "object"
    },
    "galleryView": {
      "properties": {
        "address": {
          "ref": "community.lexicon.location.address",
          "type": "ref"
        },
        "cameras": {
          "description": "List of camera make and models used in this gallery derived from EXIF data.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cid": {
          "format": "cid",
          "type": "string"
        },
        "commentCount": {
          "type": "integer"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "creator": {
          "ref": "social.grain.actor.defs#profileView",
          "type": "ref"
        },
        "crossPost": {
          "ref": "#crossPostInfo",
          "type": "ref"
        },
        "description": {
          "type": "string"
        },
        "facets": {
          "description": "Annotations of description text (mentions, URLs, hashtags, etc)",
          "items": {
            "ref": "app.bsky.richtext.facet",
            "type": "ref"
          },
          "type": "array"
        },
        "favCount": {
          "type": "integer"
        },
        "favedByFollowing": {
          "description": "Profiles of accounts the viewer follows who favorited this gallery. Capped for display — see favCount for the total. Excludes the viewer.",
          "items": {
            "ref": "social.grain.actor.defs#profileView",
            "type": "ref"
          },
          "type": "array"
        },
        "group": {
          "description": "The group whose pool this gallery was in, of the opensocial prototype. Not set now: see inGroup.",
          "ref": "social.grain.group.defs#groupRef",
          "type": "ref"
        },
        "inGroup": {
          "description": "The org.atgrp group this gallery is in, if any (the first, where it is in several).",
          "ref": "social.grain.group.defs#galleryGroupView",
          "type": "ref"
        },
        "indexedAt": {
          "format": "datetime",
          "type": "string"
        },
        "items": {
          "items": {
            "refs": [
              "social.grain.photo.defs#photoView"
            ],
            "type": "union"
          },
          "type": "array"
        },
        "labels": {
          "items": {
            "ref": "com.atproto.label.defs#label",
            "type": "ref"
          },
          "type": "array"
        },
        "location": {
          "ref": "community.lexicon.location.hthree",
          "type": "ref"
        },
        "locationDisplay": {
          "description": "Formatted location label for display.",
          "type": "string"
        },
        "record": {
          "type": "unknown"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        },
        "viewer": {
          "ref": "#viewerState",
          "type": "ref"
        }
      },
      "required": [
        "uri",
        "cid",
        "creator",
        "record",
        "indexedAt"
      ],
      "type": "object"
    },
    "locationItem": {
      "properties": {
        "galleryCount": {
          "type": "integer"
        },
        "h3Cells": {
          "description": "All H3 cells whose galleries map to this place. Ordered by gallery count desc.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "h3Index": {
          "description": "Canonical H3 cell for the place (densest cell in the group).",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "thumbs": {
          "description": "Up to four representative photo thumbnails, most recent first. Lets the index render without a feed request per location.",
          "items": {
            "format": "uri",
            "type": "string"
          },
          "maxLength": 4,
          "type": "array"
        }
      },
      "required": [
        "name",
        "h3Index",
        "galleryCount"
      ],
      "type": "object"
    },
    "viewerState": {
      "description": "Metadata about the requesting account's relationship with the subject content. Only has meaningful content for authed requests.",
      "properties": {
        "fav": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "id": "social.grain.gallery.defs",
  "lexicon": 1
}
