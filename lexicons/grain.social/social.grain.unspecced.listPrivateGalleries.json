{
  "id": "social.grain.unspecced.listPrivateGalleries",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "galleries"
          ],
          "properties": {
            "galleries": {
              "type": "array",
              "items": {
                "ref": "#privateGalleryRef",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          }
        }
      },
      "description": "The viewer's own private galleries, read from the spaces their PDS holds. Authors only: a space tells its members nothing about itself, so an account added to someone else's gallery cannot enumerate it and needs the link."
    },
    "privateGalleryRef": {
      "type": "object",
      "required": [
        "space",
        "skey"
      ],
      "properties": {
        "skey": {
          "type": "string",
          "description": "Also the gallery record's rkey."
        },
        "space": {
          "type": "string",
          "description": "Space URI the gallery lives in."
        },
        "title": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
