{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "The viewer's own private galleries, read from the spaces their PDS holds. Authors only: a space tells its members nothing about itself, so an account added to someone else's gallery cannot enumerate it and needs the link.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "galleries": {
              "items": {
                "ref": "#privateGalleryRef",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": [
            "galleries"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "params"
      },
      "type": "query"
    },
    "privateGalleryRef": {
      "properties": {
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "skey": {
          "description": "Also the gallery record's rkey.",
          "type": "string"
        },
        "space": {
          "description": "Space URI the gallery lives in.",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "space",
        "skey"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.listPrivateGalleries",
  "lexicon": 1
}
