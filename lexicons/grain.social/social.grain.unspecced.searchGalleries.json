{
  "id": "social.grain.unspecced.searchGalleries",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "ref": "social.grain.gallery.defs#galleryView",
                "type": "ref"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "q"
        ],
        "properties": {
          "q": {
            "type": "string",
            "description": "Search query"
          },
          "fuzzy": {
            "type": "boolean",
            "default": true
          },
          "limit": {
            "type": "integer",
            "default": 30,
            "maximum": 100,
            "minimum": 1
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "description": "Full-text search for galleries, returning full gallery views."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
