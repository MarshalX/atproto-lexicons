      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "authors": {
              "items": {
                "ref": "social.grain.story.defs#storyAuthor",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": [
            "authors"
          ],
          "type": "object"
        }
      },
      "type": "query"
    }
  },
  "id": "social.grain.story.getAuthors",
  "lexicon": 1
}
