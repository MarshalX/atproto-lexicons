{
  "id": "social.grain.unspecced.getGalleryFavorites",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "ref": "social.grain.unspecced.getGalleryFavorites#favoriteItem",
                "type": "ref"
              }
            },
            "cursor": {
              "type": "string"
            },
            "totalCount": {
              "type": "integer"
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "gallery"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          },
          "cursor": {
            "type": "string"
          },
          "viewer": {
            "type": "string",
            "format": "did"
          },
          "gallery": {
            "type": "string",
            "format": "at-uri"
          }
        }
      },
      "description": "Get the accounts that have favorited a gallery, most recent first."
    },
    "favoriteItem": {
      "type": "object",
      "required": [
        "did"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "avatar": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "viewer": {
          "ref": "social.grain.actor.defs#viewerState",
          "type": "ref"
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
