                "ref": "social.grain.unspecced.getGalleryFavorites#favoriteItem",
                "type": "ref"
              },
              "type": "array"
            },
            "totalCount": {
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "cursor": {
            "type": "string"
          },
          "gallery": {
            "format": "at-uri",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "viewer": {
            "format": "did",
            "type": "string"
          }
        },
        "required": [
          "gallery"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "social.grain.unspecced.getGalleryFavorites",
  "lexicon": 1
