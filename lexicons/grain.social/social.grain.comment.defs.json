{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "commentView": {
      "properties": {
        "author": {
          "ref": "social.grain.actor.defs#profileView",
          "type": "ref"
        },
        "cid": {
          "format": "cid",
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "facets": {
          "description": "Annotations of description text (mentions and URLs, hashtags, etc)",
          "items": {
            "ref": "app.bsky.richtext.facet",
            "type": "ref"
          },
          "type": "array"
        },
        "favCount": {
          "type": "integer"
        },
        "focus": {
          "description": "The photo that the comment is focused on, if applicable.",
          "refs": [
            "social.grain.photo.defs#photoView"
          ],
          "type": "union"
        },
        "muted": {
          "description": "True if the viewer has muted the comment author. Client should show collapsed with option to expand.",
          "type": "boolean"
        },
        "record": {
          "type": "unknown"
        },
        "replyTo": {
          "description": "The URI of the comment this comment is replying to, if applicable.",
          "format": "at-uri",
          "type": "string"
        },
        "subject": {
          "description": "The subject of the comment, which can be a gallery or a photo.",
          "refs": [
            "social.grain.gallery.defs#galleryView"
          ],
          "type": "union"
        },
        "text": {
          "maxGraphemes": 300,
          "maxLength": 3000,
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        },
        "viewer": {
          "ref": "#viewerState",
          "type": "ref"
        }
      },
      "required": [
        "uri",
        "cid",
        "author",
        "text",
        "createdAt"
      ],
      "type": "object"
    },
    "viewerState": {
      "description": "Metadata about the requesting account's relationship with the comment. Only has meaningful content for authed requests.",
      "properties": {
        "fav": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "id": "social.grain.comment.defs",
  "lexicon": 1
}
