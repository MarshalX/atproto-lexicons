{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Basic EXIF metadata for a photo. Integers are scaled by 1000000 to accommodate decimal values and potentially other tags in the future.",
      "key": "tid",
      "record": {
        "properties": {
          "createdAt": {
            "format": "datetime",
            "type": "string"
          },
          "dateTimeOriginal": {
            "format": "datetime",
            "type": "string"
          },
          "exposureTime": {
            "type": "integer"
          },
          "fNumber": {
            "type": "integer"
          },
          "flash": {
            "type": "string"
          },
          "focalLengthIn35mmFormat": {
            "type": "integer"
          },
          "iSO": {
            "type": "integer"
          },
          "lensMake": {
            "type": "string"
          },
          "lensModel": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "photo": {
            "format": "at-uri",
            "type": "string"
          }
        },
        "required": [
          "photo",
          "createdAt"
        ],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "social.grain.photo.exif",
  "lexicon": 1
}
