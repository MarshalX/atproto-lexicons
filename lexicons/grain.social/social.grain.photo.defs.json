{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "exifView": {
      "properties": {
        "cid": {
          "format": "cid",
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "dateTimeOriginal": {
          "type": "string"
        },
        "exposureTime": {
          "type": "string"
        },
        "fNumber": {
          "type": "string"
        },
        "flash": {
          "type": "string"
        },
        "focalLengthIn35mmFormat": {
          "type": "string"
        },
        "iSO": {
          "type": "integer"
        },
        "lensMake": {
          "type": "string"
        },
        "lensModel": {
          "type": "string"
        },
        "make": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "photo": {
          "format": "at-uri",
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "cid",
        "photo",
        "createdAt"
      ],
      "type": "object"
    },
    "galleryState": {
      "description": "Metadata about the photo's relationship with the subject content. Only has meaningful content when photo is attached to a gallery.",
      "properties": {
        "item": {
          "format": "at-uri",
          "type": "string"
        },
        "itemCreatedAt": {
          "format": "datetime",
          "type": "string"
        },
        "itemPosition": {
          "type": "integer"
        }
      },
      "required": [
        "item",
        "itemCreatedAt",
        "itemPosition"
      ],
      "type": "object"
    },
    "photoView": {
      "properties": {
        "alt": {
          "description": "Alt text description of the image, for accessibility.",
          "type": "string"
        },
        "aspectRatio": {
          "ref": "social.grain.defs#aspectRatio",
          "type": "ref"
        },
        "cid": {
          "format": "cid",
          "type": "string"
        },
        "exif": {
          "description": "EXIF metadata for the photo, if available.",
          "ref": "social.grain.photo.defs#exifView",
          "type": "ref"
        },
        "fullsize": {
          "description": "Fully-qualified URL where a large version of the image can be fetched. May or may not be the exact original blob. For example, CDN location provided by the App View.",
          "format": "uri",
          "type": "string"
        },
        "gallery": {
          "ref": "#galleryState",
          "type": "ref"
        },
        "thumb": {
          "description": "Fully-qualified URL where a thumbnail of the image can be fetched. For example, CDN location provided by the App View.",
          "format": "uri",
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "cid",
        "thumb",
        "fullsize",
        "aspectRatio"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.photo.defs",
  "lexicon": 1
}
