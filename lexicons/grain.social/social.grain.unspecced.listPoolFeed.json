{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Every gallery in every pool the viewer is a member of, newest first. Assembled per viewer at request time: which groups they belong to is a public fact in the index, but what is in each pool is a permissioned space, read with a credential that group's host issues. Nothing here is shared between viewers or cached.",
      "errors": [
        {
          "description": "No pool the viewer belongs to would answer.",
          "name": "NotAuthorized"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "galleries": {
              "items": {
                "ref": "#poolFeedItem",
                "type": "ref"
              },
              "type": "array"
            },
            "groups": {
              "description": "The pools these came out of, so a card can say whose it is.",
              "items": {
                "ref": "social.grain.group.defs#groupView",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": [
            "galleries",
            "groups"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "limit": {
            "default": 30,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "params"
      },
      "type": "query"
    },
    "poolFeedItem": {
      "properties": {
        "avatar": {
          "description": "The author's Grain profile picture, a public record of their own.",
          "type": "string"
        },
        "commentCount": {
          "type": "integer"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "description": "Whose gallery it is.",
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "favCount": {
          "type": "integer"
        },
        "group": {
          "description": "Whose pool it is in.",
          "format": "did",
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "items": {
          "items": {
            "ref": "social.grain.unspecced.getPrivateGallery#privateItem",
            "type": "ref"
          },
          "type": "array"
        },
        "photoCount": {
          "type": "integer"
        },
        "rkey": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uri": {
          "description": "What a favourite or a comment names.",
          "format": "at-uri",
          "type": "string"
        },
        "viewerFav": {
          "type": "string"
        }
      },
      "required": [
        "space",
        "group",
        "did",
        "rkey",
        "title",
        "photoCount",
        "items"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.listPoolFeed",
  "lexicon": 1
}
