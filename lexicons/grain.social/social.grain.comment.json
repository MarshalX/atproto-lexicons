{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "key": "tid",
      "record": {
        "properties": {
          "createdAt": {
            "format": "datetime",
            "type": "string"
          },
          "facets": {
            "description": "Annotations of description text (mentions and URLs, hashtags, etc)",
            "items": {
              "ref": "app.bsky.richtext.facet",
              "type": "ref"
            },
            "type": "array"
          },
          "focus": {
            "format": "at-uri",
            "type": "string"
          },
          "replyTo": {
            "format": "at-uri",
            "type": "string"
          },
          "subject": {
            "format": "at-uri",
            "type": "string"
          },
          "text": {
            "maxGraphemes": 300,
            "maxLength": 3000,
            "type": "string"
          }
        },
        "required": [
          "text",
          "subject",
          "createdAt"
        ],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "social.grain.comment",
  "lexicon": 1
}
