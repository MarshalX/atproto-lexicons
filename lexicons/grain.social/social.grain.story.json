{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "key": "tid",
      "record": {
        "properties": {
          "address": {
            "ref": "community.lexicon.location.address",
            "type": "ref"
          },
          "aspectRatio": {
            "ref": "social.grain.defs#aspectRatio",
            "type": "ref"
          },
          "createdAt": {
            "format": "datetime",
            "type": "string"
          },
          "labels": {
            "description": "Self-label values for this story. Effectively content warnings.",
            "refs": [
              "com.atproto.label.defs#selfLabels"
            ],
            "type": "union"
          },
          "location": {
            "ref": "community.lexicon.location.hthree",
            "type": "ref"
          },
          "media": {
            "accept": [
              "image/*",
              "video/*"
            ],
            "maxSize": 5000000,
            "type": "blob"
          }
        },
        "required": [
          "media",
          "aspectRatio",
          "createdAt"
        ],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "social.grain.story",
  "lexicon": 1
}
