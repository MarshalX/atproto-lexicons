{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "One gallery from a group's pool, read from the repo that holds it through a credential the group's host issues.",
      "errors": [
        {
          "description": "The viewer is not a member of this pool.",
          "name": "NotAuthorized"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "avatar": {
              "type": "string"
            },
            "avatarThumb": {
              "description": "The avatar drawn small, 144 pixels square, for faces in lines and lists.",
              "type": "string"
            },
            "commentCount": {
              "type": "integer"
            },
            "comments": {
              "items": {
                "ref": "social.grain.group.defs#poolComment",
                "type": "ref"
              },
              "type": "array"
            },
            "did": {
              "format": "did",
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "favCount": {
              "type": "integer"
            },
            "gallery": {
              "ref": "social.grain.group.defs#galleryRecord",
              "type": "ref"
            },
            "handle": {
              "type": "string"
            },
            "items": {
              "items": {
                "ref": "social.grain.group.defs#galleryItem",
                "type": "ref"
              },
              "type": "array"
            },
            "space": {
              "type": "string"
            },
            "viewerFav": {
              "description": "The rkey of the viewer's own favourite, when they have one.",
              "type": "string"
            },
            "viewerIsAuthor": {
              "type": "boolean"
            }
          },
          "required": [
            "space",
            "did",
            "items"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "did": {
            "description": "Whose gallery it is.",
            "format": "did",
            "type": "string"
          },
          "group": {
            "format": "did",
            "type": "string"
          },
          "rkey": {
            "type": "string"
          }
        },
        "required": [
          "group",
          "did",
          "rkey"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "social.grain.group.getGallery",
  "lexicon": 1
}
