{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Get the accounts that have favorited a gallery, most recent first.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "cursor": {
              "type": "string"
            },
            "items": {
              "items": {
                "ref": "social.grain.gallery.defs#favoriteItem",
                "type": "ref"
              },
              "type": "array"
            },
            "totalCount": {
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "cursor": {
            "type": "string"
          },
          "gallery": {
            "format": "at-uri",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "gallery"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "social.grain.gallery.getFavorites",
  "lexicon": 1
}
