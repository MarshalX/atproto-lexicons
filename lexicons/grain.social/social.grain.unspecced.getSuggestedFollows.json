{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Get suggested profiles to follow based on bsky follow graph.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "items": {
              "items": {
                "ref": "social.grain.unspecced.getSuggestedFollows#suggestedItem",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "actor": {
            "format": "did",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "actor"
        ],
        "type": "params"
      },
      "type": "query"
    },
    "suggestedItem": {
      "properties": {
        "avatar": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "followersCount": {
          "type": "integer"
        },
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "did"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.getSuggestedFollows",
  "lexicon": 1
}
