{
  "id": "social.grain.unspecced.getBlocks",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "ref": "social.grain.unspecced.getBlocks#blockItem",
                "type": "ref"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "description": "Get the viewer's blocked users."
    },
    "blockItem": {
      "type": "object",
      "required": [
        "did",
        "blockUri"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "avatar": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "blockUri": {
          "type": "string",
          "format": "at-uri"
        },
        "displayName": {
          "type": "string"
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
