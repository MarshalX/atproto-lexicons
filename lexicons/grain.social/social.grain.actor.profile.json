{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "A declaration of a basic account profile.",
      "key": "literal:self",
      "record": {
        "properties": {
          "avatar": {
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "description": "Small image to be displayed next to posts from account. AKA, 'profile picture'",
            "maxSize": 1000000,
            "type": "blob"
          },
          "createdAt": {
            "format": "datetime",
            "type": "string"
          },
          "description": {
            "description": "Free-form profile description text.",
            "maxGraphemes": 256,
            "maxLength": 2560,
            "type": "string"
          },
          "displayName": {
            "maxGraphemes": 64,
            "maxLength": 640,
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "social.grain.actor.profile",
  "lexicon": 1
}
