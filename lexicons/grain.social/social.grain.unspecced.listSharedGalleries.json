{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Private galleries other accounts have shared with the viewer. Answered from grain's own record of who a gallery was shared with, because a space leaves no trace on a member's PDS — then confirmed against the authority, so a gallery the viewer was removed from does not appear.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "galleries": {
              "items": {
                "ref": "#sharedGalleryRef",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": [
            "galleries"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "limit": {
            "default": 25,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "params"
      },
      "type": "query"
    },
    "sharedGalleryRef": {
      "properties": {
        "author": {
          "format": "did",
          "type": "string"
        },
        "authorHandle": {
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "skey": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "space",
        "skey",
        "author"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.listSharedGalleries",
  "lexicon": 1
}
