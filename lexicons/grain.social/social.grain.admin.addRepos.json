{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Start tracking repos, and backfill them. Requires an admin session.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "dids": {
              "items": {
                "format": "did",
                "type": "string"
              },
              "maxLength": 100,
              "minLength": 1,
              "type": "array"
            }
          },
          "required": [
            "dids"
          ],
          "type": "object"
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "added": {
              "type": "integer"
            }
          },
          "required": [
            "added"
          ],
          "type": "object"
        }
      },
      "type": "procedure"
    }
  },
  "id": "social.grain.admin.addRepos",
  "lexicon": 1
}
