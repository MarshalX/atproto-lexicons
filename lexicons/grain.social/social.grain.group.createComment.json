{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Comment on a gallery in a group's pool. The comment is the viewer's own record, written into the pool beside the gallery it answers, so only that group's members can read it.",
      "errors": [
        {
          "description": "The viewer is not a member of this pool.",
          "name": "NotAuthorized"
        }
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "facets": {
              "items": {
                "ref": "app.bsky.richtext.facet",
                "type": "ref"
              },
              "type": "array"
            },
            "gallery": {
              "format": "at-uri",
              "type": "string"
            },
            "group": {
              "format": "did",
              "type": "string"
            },
            "replyTo": {
              "format": "at-uri",
              "type": "string"
            },
            "text": {
              "maxLength": 3000,
              "type": "string"
            }
          },
          "required": [
            "group",
            "gallery",
            "text"
          ],
          "type": "object"
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "rkey": {
              "type": "string"
            },
            "uri": {
              "format": "at-uri",
              "type": "string"
            }
          },
          "required": [
            "uri",
            "rkey"
          ],
          "type": "object"
        }
      },
      "type": "procedure"
    }
  },
  "id": "social.grain.group.createComment",
  "lexicon": 1
}
