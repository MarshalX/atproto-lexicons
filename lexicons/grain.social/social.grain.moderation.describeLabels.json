{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "The labels this server gives out and what each means, as an app.bsky.labeler.service record's policies say for a Bluesky labeler. Anyone may ask.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "did": {
              "description": "The labeler, as its labels name it in src. Absent from a server with no DID.",
              "format": "did",
              "type": "string"
            },
            "policies": {
              "ref": "app.bsky.labeler.defs#labelerPolicies",
              "type": "ref"
            }
          },
          "required": [
            "policies"
          ],
          "type": "object"
        }
      },
      "type": "query"
    }
  },
  "id": "social.grain.moderation.describeLabels",
  "lexicon": 1
}
