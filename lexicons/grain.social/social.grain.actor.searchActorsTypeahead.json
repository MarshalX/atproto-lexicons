              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "limit": {
            "default": 5,
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          },
          "q": {
            "description": "Search query",
            "type": "string"
          }
        },
        "required": [
          "q"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "social.grain.actor.searchActorsTypeahead",
