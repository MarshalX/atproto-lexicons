{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Who a private gallery is shared with. Read from the space's authority, which is the only place the member list exists, so only the gallery's author can ask.",
      "errors": [
        {
          "description": "Only the gallery's author may list its members.",
          "name": "NotAuthorized"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "members": {
              "items": {
                "ref": "#memberView",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": [
            "members"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "space": {
            "type": "string"
          }
        },
        "required": [
          "space"
        ],
        "type": "params"
      },
      "type": "query"
    },
    "memberView": {
      "properties": {
        "avatar": {
          "format": "uri",
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "did"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.getSpaceMembers",
  "lexicon": 1
}
