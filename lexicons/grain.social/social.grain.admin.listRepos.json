{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Tracked repos, most recently backfilled first. q finds them by part of a DID or handle. Requires an admin session.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "cursor": {
              "type": "string"
            },
            "repos": {
              "items": {
                "ref": "social.grain.admin.defs#repoView",
                "type": "ref"
              },
              "type": "array"
            },
            "total": {
              "type": "integer"
            }
          },
          "required": [
            "repos",
            "total"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "q": {
            "description": "Part of a DID or handle.",
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "social.grain.admin.listRepos",
  "lexicon": 1
}
