{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "messageMe": {
      "properties": {
        "messageMeUrl": {
          "format": "uri",
          "type": "string"
        },
        "showButtonTo": {
          "knownValues": [
            "usersIFollow",
            "everyone"
          ],
          "type": "string"
        }
      },
      "required": [
        "showButtonTo",
        "messageMeUrl"
      ],
      "type": "object"
    },
    "notificationPref": {
      "properties": {
        "from": {
          "knownValues": [
            "all",
            "follows"
          ],
          "type": "string"
        },
        "inApp": {
          "type": "boolean"
        },
        "push": {
          "type": "boolean"
        }
      },
      "required": [
        "push",
        "inApp",
        "from"
      ],
      "type": "object"
    },
    "notificationsPref": {
      "description": "How each kind of notification reaches the viewer. A kind left out takes the default: push and in-app, from anyone.",
      "properties": {
        "comments": {
          "ref": "#notificationPref",
          "type": "ref"
        },
        "favorites": {
          "ref": "#notificationPref",
          "type": "ref"
        },
        "follows": {
          "ref": "#notificationPref",
          "type": "ref"
        },
        "mentions": {
          "ref": "#notificationPref",
          "type": "ref"
        }
      },
      "type": "object"
    },
    "photoMetadataPref": {
      "description": "What an upload keeps of a photo's metadata.",
      "properties": {
        "includeExif": {
          "description": "Keep camera settings on uploaded photos.",
          "type": "boolean"
        },
        "includeLocation": {
          "description": "Keep where a photo was taken on uploaded photos.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "pinnedFeed": {
      "properties": {
        "id": {
          "maxLength": 2048,
          "type": "string"
        },
        "label": {
          "maxLength": 640,
          "type": "string"
        },
        "path": {
          "description": "The page it opens, on this site.",
          "maxLength": 2048,
          "type": "string"
        },
        "type": {
          "knownValues": [
            "feed",
            "camera",
            "location",
            "hashtag"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "path"
      ],
      "type": "object"
    },
    "pinnedFeedsPref": {
      "description": "The feeds pinned to the viewer's navigation.",
      "properties": {
        "items": {
          "description": "In the order they show.",
          "items": {
            "ref": "#pinnedFeed",
            "type": "ref"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "preferences": {
      "items": {
        "refs": [
          "#pinnedFeedsPref",
          "#photoMetadataPref",
          "#themePref",
          "#notificationsPref"
        ],
        "type": "union"
      },
      "type": "array"
    },
    "profileSearchResult": {
      "properties": {
        "avatar": {
          "type": "string"
        },
        "avatarThumb": {
          "description": "The avatar drawn small, 144 pixels square, for faces in lines and lists.",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "did"
      ],
      "type": "object"
    },
    "profileView": {
      "properties": {
        "avatar": {
          "format": "uri",
          "type": "string"
        },
        "avatarThumb": {
          "description": "The avatar drawn small, 144 pixels square, for faces in lines and lists.",
          "format": "uri",
          "type": "string"
        },
        "cid": {
          "format": "cid",
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "description": {
          "maxGraphemes": 256,
          "maxLength": 2560,
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "maxGraphemes": 64,
          "maxLength": 640,
          "type": "string"
        },
        "handle": {
          "format": "handle",
          "type": "string"
        },
        "labels": {
          "items": {
            "ref": "com.atproto.label.defs#label",
            "type": "ref"
          },
          "type": "array"
        }
      },
      "required": [
        "did",
        "handle"
      ],
      "type": "object"
    },
    "profileViewDetailed": {
      "properties": {
        "avatar": {
          "format": "uri",
          "type": "string"
        },
        "avatarThumb": {
          "description": "The avatar drawn small, 144 pixels square, for faces in lines and lists.",
          "format": "uri",
          "type": "string"
        },
        "cameras": {
          "description": "List of camera make and models used by this actor derived from EXIF data of photos linked to galleries.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cid": {
          "format": "cid",
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "description": {
          "maxGraphemes": 256,
          "maxLength": 2560,
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "maxGraphemes": 64,
          "maxLength": 640,
          "type": "string"
        },
        "followersCount": {
          "type": "integer"
        },
        "followsCount": {
          "type": "integer"
        },
        "galleryCount": {
          "type": "integer"
        },
        "handle": {
          "format": "handle",
          "type": "string"
        },
        "indexedAt": {
          "format": "datetime",
          "type": "string"
        },
        "labels": {
          "items": {
            "ref": "com.atproto.label.defs#label",
            "type": "ref"
          },
          "type": "array"
        },
        "messageMe": {
          "ref": "#messageMe",
          "type": "ref"
        },
        "viewer": {
          "ref": "#viewerState",
          "type": "ref"
        }
      },
      "required": [
        "did",
        "handle"
      ],
      "type": "object"
    },
    "suggestedFollow": {
      "properties": {
        "avatar": {
          "type": "string"
        },
        "avatarThumb": {
          "description": "The avatar drawn small, 144 pixels square, for faces in lines and lists.",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "followersCount": {
          "type": "integer"
        },
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "did"
      ],
      "type": "object"
    },
    "themePref": {
      "properties": {
        "theme": {
          "knownValues": [
            "system",
            "light",
            "dark"
          ],
          "type": "string"
        }
      },
      "required": [
        "theme"
      ],
      "type": "object"
    },
    "typeaheadItem": {
      "properties": {
        "avatar": {
          "type": "string"
        },
        "avatarThumb": {
          "description": "The avatar drawn small, 144 pixels square, for faces in lines and lists.",
          "type": "string"
        },
        "did": {
          "format": "did",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        }
      },
      "required": [
        "did"
      ],
      "type": "object"
    },
    "viewerState": {
      "description": "Metadata about the requesting account's relationship with the subject account. Only has meaningful content for authed requests.",
      "properties": {
        "blockedBy": {
          "type": "boolean"
        },
        "blocking": {
          "format": "at-uri",
          "type": "string"
        },
        "followedBy": {
          "format": "at-uri",
          "type": "string"
        },
        "following": {
          "format": "at-uri",
          "type": "string"
        },
        "muted": {
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "id": "social.grain.actor.defs",
  "lexicon": 1
}
