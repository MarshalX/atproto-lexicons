{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Groups worth browsing, most recently active first. With `gallery`, each group carries the viewer's standing for that gallery.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "cursor": {
              "type": "string"
            },
            "groups": {
              "items": {
                "ref": "social.grain.group.defs#groupView",
                "type": "ref"
              },
              "type": "array"
            }
          },
          "required": [
            "groups"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "cursor": {
            "type": "string"
          },
          "gallery": {
            "format": "at-uri",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "social.grain.group.listGroups",
  "lexicon": 1
}
