{
  "id": "social.grain.unspecced.joinGroup",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "schema": {
          "type": "object",
          "required": [
            "group"
          ],
          "properties": {
            "group": {
              "type": "string",
              "format": "did"
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "encoding": "application/json"
      },
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "knownValues": [
                "admitted",
                "pending"
              ]
            }
          }
        },
        "encoding": "application/json"
      },
      "description": "Ask a group's group host to admit the viewer: Grain mints service auth for the host from the viewer's PDS and calls fyi.opensocial.requestJoin. Admitted immediately when the group is open; queued for its moderators when it takes requests."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
