{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "storyAuthor": {
      "properties": {
        "lastViewedAt": {
          "description": "createdAt of the newest of this author's live stories the requesting account has watched. Compare against latestAt to tell whether the viewer is caught up. Only present for an authenticated viewer who has watched at least one.",
          "format": "datetime",
          "type": "string"
        },
        "latestAt": {
          "format": "datetime",
          "type": "string"
        },
        "profile": {
          "ref": "social.grain.actor.defs#profileView",
          "type": "ref"
        },
        "storyCount": {
          "type": "integer"
        },
        "unviewedCount": {
          "description": "How many of this author's live stories the requesting account has not watched. Only present for an authenticated viewer.",
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "storyCount",
        "latestAt"
      ],
      "type": "object"
    },
    "storyView": {
      "properties": {
        "address": {
          "ref": "community.lexicon.location.address",
          "type": "ref"
        },
        "aspectRatio": {
          "ref": "social.grain.defs#aspectRatio",
          "type": "ref"
        },
        "cid": {
          "format": "cid",
          "type": "string"
        },
        "commentCount": {
          "type": "integer"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "creator": {
          "ref": "social.grain.actor.defs#profileView",
          "type": "ref"
        },
        "crossPost": {
          "ref": "social.grain.gallery.defs#crossPostInfo",
          "type": "ref"
        },
        "expired": {
          "description": "Whether the story has passed its 24-hour window.",
          "type": "boolean"
        },
        "fullsize": {
          "description": "URL of the story image drawn for a screen, 1440 pixels wide.",
          "format": "uri",
          "type": "string"
        },
        "labels": {
          "items": {
            "ref": "com.atproto.label.defs#label",
            "type": "ref"
          },
          "type": "array"
        },
        "location": {
          "ref": "community.lexicon.location.hthree",
          "type": "ref"
        },
        "locationDisplay": {
          "description": "Formatted location label for display.",
          "type": "string"
        },
        "thumb": {
          "description": "Thumbnail URL for the story image.",
          "format": "uri",
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        },
        "viewer": {
          "ref": "#viewerState",
          "type": "ref"
        }
      },
      "required": [
        "uri",
        "cid",
        "creator",
        "thumb",
        "fullsize",
        "aspectRatio",
        "createdAt"
      ],
      "type": "object"
    },
    "viewerState": {
      "description": "Metadata about the requesting account's relationship with the story.",
      "properties": {
        "fav": {
          "format": "at-uri",
          "type": "string"
        },
        "viewed": {
          "description": "Whether the requesting account has watched this story. Only present when true.",
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "id": "social.grain.story.defs",
  "lexicon": 1
}
