{
  "$type": "com.atproto.lexicon.schema",
  "defs": {
    "main": {
      "description": "Get notifications for the authenticated user.",
      "output": {
        "encoding": "application/json",
        "schema": {
          "properties": {
            "cursor": {
              "type": "string"
            },
            "notifications": {
              "items": {
                "ref": "#notificationItem",
                "type": "ref"
              },
              "type": "array"
            },
            "unseenCount": {
              "type": "integer"
            }
          },
          "required": [
            "notifications"
          ],
          "type": "object"
        }
      },
      "parameters": {
        "properties": {
          "countOnly": {
            "description": "If true, only return unseenCount without hydrating notifications.",
            "type": "boolean"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "params"
      },
      "type": "query"
    },
    "notificationItem": {
      "properties": {
        "author": {
          "ref": "social.grain.actor.defs#profileView",
          "type": "ref"
        },
        "commentText": {
          "type": "string"
        },
        "createdAt": {
          "format": "datetime",
          "type": "string"
        },
        "galleryThumb": {
          "type": "string"
        },
        "galleryTitle": {
          "type": "string"
        },
        "galleryUri": {
          "format": "at-uri",
          "type": "string"
        },
        "reason": {
          "knownValues": [
            "gallery-favorite",
            "gallery-comment",
            "gallery-comment-mention",
            "gallery-mention",
            "comment-favorite",
            "story-favorite",
            "story-comment",
            "reply",
            "follow"
          ],
          "type": "string"
        },
        "replyToText": {
          "type": "string"
        },
        "storyThumb": {
          "type": "string"
        },
        "storyUri": {
          "format": "at-uri",
          "type": "string"
        },
        "uri": {
          "format": "at-uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "reason",
        "createdAt",
        "author"
      ],
      "type": "object"
    }
  },
  "id": "social.grain.unspecced.getNotifications",
  "lexicon": 1
}
