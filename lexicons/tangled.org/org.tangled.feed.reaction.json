{
  "id": "org.tangled.feed.reaction",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "reaction",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "ref": "com.atproto.repo.strongRef",
            "type": "ref"
          },
          "reaction": {
            "enum": [
              "👍",
              "👎",
              "😆",
              "🎉",
              "🫤",
              "❤️",
              "🚀",
              "👀"
            ],
            "type": "string",
            "maxGraphemes": 1
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
