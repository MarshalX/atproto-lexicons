{
  "id": "org.tangled.markup.embed.image",
  "defs": {
    "main": {
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "blob",
          "accept": [
            "image/*"
          ],
          "maxSize": 1000000
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
