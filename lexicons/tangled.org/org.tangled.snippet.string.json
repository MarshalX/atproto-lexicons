{
  "id": "org.tangled.snippet.string",
  "defs": {
    "main": {
      "key": "any",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "snippet",
          "createdAt"
        ],
        "properties": {
          "snippet": {
            "refs": [
              "#textFile"
            ],
            "type": "union"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "description": {
            "type": "string",
            "maxGraphemes": 256
          }
        }
      },
      "description": "TID is preferred for record-key, but not enforced."
    },
    "textFile": {
      "type": "object",
      "required": [
        "name",
        "content"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "file name",
          "maxGraphemes": 140
        },
        "content": {
          "type": "blob",
          "accept": [
            "text/plain"
          ],
          "maxLength": 1000000
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
