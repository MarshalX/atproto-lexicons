{
  "id": "radio.4000.getRadioTracks",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "tracks"
          ],
          "properties": {
            "tracks": {
              "type": "array",
              "items": {
                "ref": "radio.4000.defs#trackView",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": [
          "radio"
        ],
        "properties": {
          "radio": {
            "type": "string",
            "format": "did",
            "description": "The radio's DID."
          }
        }
      },
      "description": "Every track of one radio, newest first, in one answer: what a radio's page and its decks load. Does not require auth."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
