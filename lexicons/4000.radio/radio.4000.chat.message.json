{
  "id": "radio.4000.chat.message",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "text",
          "createdAt"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300
          },
          "track": {
            "type": "string",
            "format": "at-uri",
            "description": "A radio.4000.track record the message is about, like the one playing as it was sent."
          },
          "subject": {
            "type": "string",
            "format": "did",
            "description": "The radio whose room this is."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      },
      "description": "A message in the public chat room of a radio. Lives in the sender's repo."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
