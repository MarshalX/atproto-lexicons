{
  "id": "radio.4000.listRadios",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "radios"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "radios": {
              "type": "array",
              "items": {
                "ref": "radio.4000.defs#radioView",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 300,
            "description": "Words to find in names, handles and descriptions."
          },
          "bbox": {
            "type": "string",
            "maxLength": 100,
            "description": "Only radios located in this area: 'west,south,east,north' in decimal degrees."
          },
          "sort": {
            "type": "string",
            "default": "latest",
            "description": "latest: by latest track; new: by creation; tracks: by number of tracks.",
            "knownValues": [
              "latest",
              "new",
              "tracks"
            ]
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "description": "Radios of the network, paged. Does not require auth."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
