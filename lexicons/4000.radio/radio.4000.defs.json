{
  "id": "radio.4000.defs",
  "defs": {
    "link": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "maxLength": 640,
          "maxGraphemes": 64
        }
      },
      "description": "A link to elsewhere, with an optional label."
    },
    "author": {
      "type": "object",
      "required": [
        "did",
        "handle"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "handle": {
          "type": "string",
          "format": "handle"
        }
      },
      "description": "The account a record belongs to."
    },
    "radioView": {
      "type": "object",
      "required": [
        "did",
        "handle",
        "trackCount",
        "indexedAt"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "image": {
          "type": "string",
          "format": "uri",
          "description": "URL of the radio's image blob on its PDS."
        },
        "handle": {
          "type": "string",
          "format": "handle"
        },
        "record": {
          "type": "unknown",
          "description": "The radio.4000.profile record, when the account has one."
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        },
        "trackCount": {
          "type": "integer",
          "minimum": 0
        },
        "latestTrackAt": {
          "type": "string",
          "format": "datetime"
        },
        "tracksUpdatedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When the radio's tracks last changed: an app can keep them and load them again only when this moves."
        }
      }
    },
    "trackView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "author",
        "record",
        "indexedAt"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "author": {
          "ref": "#author",
          "type": "ref"
        },
        "record": {
          "type": "unknown",
          "description": "The radio.4000.track record."
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "broadcastView": {
      "type": "object",
      "required": [
        "author",
        "record",
        "indexedAt"
      ],
      "properties": {
        "author": {
          "ref": "#author",
          "type": "ref"
        },
        "record": {
          "type": "unknown",
          "description": "The radio.4000.broadcast record."
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "chatMessageView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "author",
        "record",
        "indexedAt"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "author": {
          "ref": "#author",
          "type": "ref"
        },
        "record": {
          "type": "unknown",
          "description": "The radio.4000.chat.message record."
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "description": "Definitions shared by the records, and views of records served by the 4000.radio index. Each view carries the record as it is in its repo."
}
