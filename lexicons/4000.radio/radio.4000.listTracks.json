{
  "id": "radio.4000.listTracks",
  "defs": {
    "main": {
      "type": "query",
      "output": {
        "schema": {
          "type": "object",
          "required": [
            "tracks"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "tracks": {
              "type": "array",
              "items": {
                "ref": "radio.4000.defs#trackView",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 300,
            "description": "Words to find in titles and descriptions."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 640
            },
            "maxLength": 10,
            "description": "Only tracks with all these #tags (without #)."
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 100,
            "minimum": 1
          },
          "cursor": {
            "type": "string"
          },
          "radios": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "did"
            },
            "maxLength": 100,
            "description": "Only tracks of these radios."
          },
          "mention": {
            "type": "string",
            "format": "handle",
            "description": "Only tracks whose description @mentions this handle."
          }
        }
      },
      "description": "Tracks, newest first, from the whole network or some radios, optionally filtered. Does not require auth."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
